+  VkImageBlit region = {};
+  region.srcSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+  region.srcSubresource.layerCount = 1;
+  region.dstSubresource = region.srcSubresource;
+  region.srcOffsets[0].x = int32_t(src_x * scale_x);
+  region.srcOffsets[0].y = int32_t(src_y * scale_y);
+  region.srcOffsets[1].x = int32_t((src_x + width) * scale_x);
+  region.srcOffsets[1].y = int32_t((src_y + height) * scale_y);
+  region.srcOffsets[1].z = 1;
+  region.dstOffsets[1].x = int32_t(width * scale_x);
+  region.dstOffsets[1].y = int32_t(height * scale_y);
+  region.dstOffsets[1].z = 1;
+  command_processor_.deferred_command_buffer().CmdVkBlitImage(
+      rt.image(), VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, entry->image,
+      VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, region, VK_FILTER_NEAREST);
+  entry->layout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+  entry->write_stage = VK_PIPELINE_STAGE_TRANSFER_BIT;
+  entry->write_access = VK_ACCESS_TRANSFER_WRITE_BIT;
+  entry->valid = true;
+  ++ng2_native_resolves_recorded_;
+  return true;
+}
+bool VulkanRenderTargetCache::Ng2InitMsaaUnpack() {
+  if (ng2_msaa_unpack_init_tried_) {
+    return ng2_msaa_unpack_pipelines_[0] != VK_NULL_HANDLE &&
+           ng2_msaa_unpack_pipelines_[1] != VK_NULL_HANDLE &&
+           ng2_msaa_unpack_pipelines_[2] != VK_NULL_HANDLE &&
+           ng2_msaa_unpack_pipelines_[3] != VK_NULL_HANDLE;
+  }
+  ng2_msaa_unpack_init_tried_ = true;
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  if (descriptor_set_layout_sampled_image_ == VK_NULL_HANDLE) {
+    return false;
+  }
+  VkDescriptorSetLayoutBinding binding = {};
+  binding.binding = 0;
+  binding.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+  binding.descriptorCount = 1;
+  binding.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+  VkDescriptorSetLayoutCreateInfo layout_info = {};
+  layout_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO;
+  layout_info.bindingCount = 1;
+  layout_info.pBindings = &binding;
+  if (dfn.vkCreateDescriptorSetLayout(device, &layout_info, nullptr,
+                                      &ng2_msaa_unpack_storage_layout_) != VK_SUCCESS) {
+    ng2_msaa_unpack_storage_layout_ = VK_NULL_HANDLE;
+    return false;
+  }
+  VkDescriptorPoolSize pool_size = {VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 256};
+  VkDescriptorPoolCreateInfo pool_info = {};
+  pool_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
+  pool_info.maxSets = 256;
+  pool_info.poolSizeCount = 1;
+  pool_info.pPoolSizes = &pool_size;
+  if (dfn.vkCreateDescriptorPool(device, &pool_info, nullptr, &ng2_msaa_unpack_pool_) !=
+      VK_SUCCESS) {
+    ng2_msaa_unpack_pool_ = VK_NULL_HANDLE;
+    return false;
+  }
+  VkDescriptorSetLayout set_layouts[2] = {descriptor_set_layout_sampled_image_,
+                                          ng2_msaa_unpack_storage_layout_};
+  VkPushConstantRange push_range = {VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(int32_t) * 8};
+  VkPipelineLayoutCreateInfo pipeline_layout_info = {};
+  pipeline_layout_info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+  pipeline_layout_info.setLayoutCount = 2;
+  pipeline_layout_info.pSetLayouts = set_layouts;
+  pipeline_layout_info.pushConstantRangeCount = 1;
+  pipeline_layout_info.pPushConstantRanges = &push_range;
+  if (dfn.vkCreatePipelineLayout(device, &pipeline_layout_info, nullptr,
+                                 &ng2_msaa_unpack_pipeline_layout_) != VK_SUCCESS) {
+    ng2_msaa_unpack_pipeline_layout_ = VK_NULL_HANDLE;
+    return false;
+  }
+  // Host 1x-view pixel (x, y) = 4x pixel (x >> 1, y >> 1), sample (x & 1) | ((y & 1) << 1),
+  // the same mapping as the 4x -> 1x ownership transfer shaders.
+  static const char* const kSources[4] = {
+      R"(#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(set = 0, binding = 0) uniform texture2DMS source_texture;
+layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D dest_image;
+layout(push_constant) uniform Constants { ivec4 rect; ivec4 mode_samples; } constants;
+void main() {
+  ivec2 dest = ivec2(gl_GlobalInvocationID.xy);
+  if (dest.x >= constants.rect.z || dest.y >= constants.rect.w) return;
+  ivec2 view = constants.rect.xy + dest;
+  vec4 value;
+  if (constants.mode_samples.x == 0) {
+    value = texelFetch(source_texture, view >> 1, (view.x & 1) | ((view.y & 1) << 1));
+  } else if (constants.mode_samples.x == 1) {
+    value = 0.5 * (texelFetch(source_texture, view, constants.mode_samples.y) +
+                   texelFetch(source_texture, view, constants.mode_samples.z));
+  } else {
+    ivec2 pixel = ivec2(view.x >> 1, view.y);
+    value = 0.5 * (texelFetch(source_texture, pixel, (view.x & 1) | (constants.mode_samples.y << 1)) +
+                   texelFetch(source_texture, pixel, (view.x & 1) | (constants.mode_samples.z << 1)));
+  }
+  imageStore(dest_image, dest, value);
+}
+)",
+      R"(#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(set = 0, binding = 0) uniform utexture2DMS source_texture;
+layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D dest_image;
+layout(push_constant) uniform Constants { ivec4 rect; ivec4 mode_samples; } constants;
+void main() {
+  ivec2 dest = ivec2(gl_GlobalInvocationID.xy);
+  if (dest.x >= constants.rect.z || dest.y >= constants.rect.w) return;
+  ivec2 view = constants.rect.xy + dest;
+  vec4 value;
+  if (constants.mode_samples.x == 0) {
+    uvec4 bits = texelFetch(source_texture, view >> 1, (view.x & 1) | ((view.y & 1) << 1));
+    value = vec4(unpackHalf2x16(bits.x | (bits.y << 16)), unpackHalf2x16(bits.z | (bits.w << 16)));
+  } else {
+    ivec2 pixel = constants.mode_samples.x == 1 ? view : ivec2(view.x >> 1, view.y);
+    int sample_base = constants.mode_samples.x == 1 ? 0 : (view.x & 1);
+    int shift = constants.mode_samples.x == 1 ? 0 : 1;
+    uvec4 a = texelFetch(source_texture, pixel, sample_base | (constants.mode_samples.y << shift));
+    uvec4 b = texelFetch(source_texture, pixel, sample_base | (constants.mode_samples.z << shift));
+    value = 0.5 * (vec4(unpackHalf2x16(a.x | (a.y << 16)), unpackHalf2x16(a.z | (a.w << 16))) +
+                   vec4(unpackHalf2x16(b.x | (b.y << 16)), unpackHalf2x16(b.z | (b.w << 16))));
+  }
+  imageStore(dest_image, dest, value);
+}
+)",
+      // NG2 ADDITION (ng2_msaa_supersample): 1x surface (a stored 4x one) read as 2x - 2x
+      // pixel (x, y) guest sample g = 1x pixel (x, 2y + g); mode 3, samples in .y / .z.
+      R"(#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(set = 0, binding = 0) uniform texture2D source_texture;
+layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D dest_image;
+layout(push_constant) uniform Constants { ivec4 rect; ivec4 mode_samples; } constants;
+void main() {
+  ivec2 dest = ivec2(gl_GlobalInvocationID.xy);
+  if (dest.x >= constants.rect.z || dest.y >= constants.rect.w) return;
+  ivec2 view = constants.rect.xy + dest;
+  imageStore(dest_image, dest,
+             0.5 * (texelFetch(source_texture, ivec2(view.x, 2 * view.y + constants.mode_samples.y), 0) +
+                    texelFetch(source_texture, ivec2(view.x, 2 * view.y + constants.mode_samples.z), 0)));
+}
+)",
+      R"(#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(set = 0, binding = 0) uniform utexture2D source_texture;
+layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D dest_image;
+layout(push_constant) uniform Constants { ivec4 rect; ivec4 mode_samples; } constants;
+void main() {
+  ivec2 dest = ivec2(gl_GlobalInvocationID.xy);
+  if (dest.x >= constants.rect.z || dest.y >= constants.rect.w) return;
+  ivec2 view = constants.rect.xy + dest;
+  uvec4 a = texelFetch(source_texture, ivec2(view.x, 2 * view.y + constants.mode_samples.y), 0);
+  uvec4 b = texelFetch(source_texture, ivec2(view.x, 2 * view.y + constants.mode_samples.z), 0);
+  imageStore(dest_image, dest,
+             0.5 * (vec4(unpackHalf2x16(a.x | (a.y << 16)), unpackHalf2x16(a.z | (a.w << 16))) +
+                    vec4(unpackHalf2x16(b.x | (b.y << 16)), unpackHalf2x16(b.z | (b.w << 16)))));
+}
+)"};
+  for (uint32_t i = 0; i < 4; ++i) {
+    std::vector<uint32_t> spirv;
+    std::string error;
+    if (!command_processor_.CompileGlslToSpirv(VK_SHADER_STAGE_COMPUTE_BIT, kSources[i], spirv,
+                                               error)) {
+      REXGPU_ERROR("NG2 native resolve: MSAA unpack shader {} failed to compile: {}", i, error);
+      return false;
+    }
+    ng2_msaa_unpack_pipelines_[i] = ui::vulkan::util::CreateComputePipeline(
+        vulkan_device, ng2_msaa_unpack_pipeline_layout_, spirv.data(),
+        sizeof(uint32_t) * spirv.size());
+    if (ng2_msaa_unpack_pipelines_[i] == VK_NULL_HANDLE) {
+      return false;
+    }
+  }
+  REXGPU_INFO("NG2 native resolve: MSAA unpack pipelines created");
+  return true;
+}
+
+void VulkanRenderTargetCache::Ng2ShutdownMsaaUnpack() {
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  for (VkPipeline& pipeline : ng2_msaa_unpack_pipelines_) {
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyPipeline, device, pipeline);
+  }
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyPipelineLayout, device,
+                                         ng2_msaa_unpack_pipeline_layout_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyDescriptorPool, device,
+                                         ng2_msaa_unpack_pool_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyDescriptorSetLayout, device,
+                                         ng2_msaa_unpack_storage_layout_);
+}
 }  // namespace rex::graphics::vulkan
