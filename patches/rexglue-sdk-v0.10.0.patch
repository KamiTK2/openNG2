--- /dev/null
+++ b/src/ui/d3d12/d3d12_frame_interpolator.cpp
@@ -0,0 +1,608 @@
+/**
+ * @file        ui/d3d12/d3d12_frame_interpolator.cpp
+ * @brief       NG2 ADDITION: vendor-neutral frame generation (see the header).
+ */
+
+#include <rex/ui/d3d12/d3d12_frame_interpolator.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+
+#include <d3dcompiler.h>
+
+#include <rex/logging.h>
+#include <rex/ui/d3d12/d3d12_provider.h>
+#include <rex/ui/d3d12/d3d12_submission_tracker.h>
+#include <rex/ui/d3d12/d3d12_util.h>
+
+namespace rex::ui::d3d12 {
+
+namespace {
+
+constexpr DXGI_FORMAT kColorFormat = DXGI_FORMAT_R10G10B10A2_UNORM;  // = guest output
+constexpr DXGI_FORMAT kLumaFormat = DXGI_FORMAT_R16_FLOAT;
+constexpr DXGI_FORMAT kFlowFormat = DXGI_FORMAT_R32G32B32A32_FLOAT;
+constexpr D3D12_RESOURCE_STATES kAllShaderResource =
+    D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE | D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+constexpr D3D12_RESOURCE_STATES kNonPixel = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+constexpr uint32_t kAnalysisWidth = 960;  // target width of pyramid level 0
+constexpr uint32_t kCoarseSearchRadius = 4;
+
+// Flow convention: a flow field from frame A to frame B stores, per pixel q of A, the
+// displacement F such that A(q) ~ B(q + F), in pixels of its own pyramid level.
+const char kShaderSource[] = R"HLSL(
+cbuffer Root : register(b0) {
+  uint4 c0;
+  uint4 c1;
+  uint4 c2;
+  uint4 c3;
+};
+Texture2D<float4> t0 : register(t0);
+Texture2D<float4> t1 : register(t1);
+Texture2D<float4> t2 : register(t2);
+Texture2D<float4> t3 : register(t3);
+RWTexture2D<float4> u0 : register(u0);
+SamplerState sLinear : register(s0);
+SamplerState sPoint : register(s1);
+
+static const float3 kLuma = float3(0.299, 0.587, 0.114);
+
+// ---- pyramid ----------------------------------------------------------------------
+// c0.xy = dst size, c0.zw = src size. Box filter of the (src/dst) footprint (<= 4x4)
+// with four bilinear taps.
+[numthreads(8, 8, 1)] void CSLuma(uint2 id : SV_DispatchThreadID) {
+  if (any(id >= c0.xy)) return;
+  float2 scale = float2(c0.zw) / float2(c0.xy);
+  float2 inv = 1.0 / float2(c0.zw);
+  float s = 0.0;
+  [unroll] for (int y = 0; y < 2; ++y) {
+    [unroll] for (int x = 0; x < 2; ++x) {
+      float2 pos = (float2(id) + float2(0.25 + 0.5 * x, 0.25 + 0.5 * y)) * scale;
+      s += dot(t0.SampleLevel(sLinear, pos * inv, 0).rgb, kLuma);
+    }
+  }
+  u0[id] = float4(s * 0.25, 0, 0, 0);
+}
+
+// 2x2 average (one bilinear tap at the centre of the 2x2 footprint).
+[numthreads(8, 8, 1)] void CSDown(uint2 id : SV_DispatchThreadID) {
+  if (any(id >= c0.xy)) return;
+  float2 pos = (float2(id) + 0.5) * float2(c0.zw) / float2(c0.xy);
+  u0[id] = float4(t0.SampleLevel(sLinear, pos / float2(c0.zw), 0).r, 0, 0, 0);
+}
+
+// ---- flow -------------------------------------------------------------------------
+#define WIN 25  // 5x5 window
+
+float LoadL(Texture2D<float4> t, int2 q, int2 size) {
+  return t.Load(int3(clamp(q, int2(0, 0), size - 1), 0)).r;
+}
+
+int2 WinOffset(int j) { return int2(j % 5 - 2, j / 5 - 2); }
+
+// Zero-mean mean-absolute difference between the template window of A at p and the
+// window of B (t1) at p + F. Zero-mean makes it insensitive to fades/brightness ramps.
+float WindowCost(float A[WIN], float meanA, int2 p, float2 F, float2 inv) {
+  float B[WIN];
+  float s = 0.0;
+  [unroll] for (int j = 0; j < WIN; ++j) {
+    B[j] = t1.SampleLevel(sLinear, (float2(p + WinOffset(j)) + 0.5 + F) * inv, 0).r;
+    s += B[j];
+  }
+  float meanB = s / WIN;
+  float c = 0.0;
+  [unroll] for (int k = 0; k < WIN; ++k) c += abs((B[k] - meanB) - (A[k] - meanA));
+  return c / WIN;
+}
+
+// One pyramid level of flow from A (t0) to B (t1).
+// c0.xy = level size; c1.xy = coarser level size, c1.z = has coarser flow (t2),
+// c1.w = has prior flow (t3, level-0 flow of the previous frame pair);
+// c2.xy = prior scale (asfloat), c2.zw = coarser-to-this scale (asfloat);
+// c3.y = full search radius (coarsest level only).
+[numthreads(8, 8, 1)] void CSRefine(uint2 id : SV_DispatchThreadID) {
+  if (any(id >= c0.xy)) return;
+  int2 size = int2(c0.xy);
+  float2 inv = 1.0 / float2(size);
+  int2 p = int2(id);
+  float2 uv = (float2(p) + 0.5) * inv;
+
+  // Template window, its mean and gradients.
+  float A[WIN], gx[WIN], gy[WIN];
+  float meanA = 0.0;
+  float h00 = 0.0, h01 = 0.0, h11 = 0.0;
+  [unroll] for (int j = 0; j < WIN; ++j) {
+    int2 q = p + WinOffset(j);
+    A[j] = LoadL(t0, q, size);
+    meanA += A[j];
+    gx[j] = 0.5 * (LoadL(t0, q + int2(1, 0), size) - LoadL(t0, q - int2(1, 0), size));
+    gy[j] = 0.5 * (LoadL(t0, q + int2(0, 1), size) - LoadL(t0, q - int2(0, 1), size));
+    h00 += gx[j] * gx[j];
+    h01 += gx[j] * gy[j];
+    h11 += gy[j] * gy[j];
+  }
+  meanA /= WIN;
+
+  // Candidates.
+  float2 best = float2(0, 0);
+  float best_cost = WindowCost(A, meanA, p, best, inv) - 0.002;  // slight zero preference
+  float2 up = asfloat(c2.zw);
+  if (c1.z) {
+    int2 csize = int2(c1.xy);
+    int2 cp = clamp(int2(uv * float2(csize)), int2(0, 0), csize - 1);
+    float2 cand[5];
+    cand[0] = t2.SampleLevel(sLinear, uv, 0).xy * up;
+    cand[1] = t2.Load(int3(clamp(cp + int2(-1, 0), int2(0, 0), csize - 1), 0)).xy * up;
+    cand[2] = t2.Load(int3(clamp(cp + int2(1, 0), int2(0, 0), csize - 1), 0)).xy * up;
+    cand[3] = t2.Load(int3(clamp(cp + int2(0, -1), int2(0, 0), csize - 1), 0)).xy * up;
+    cand[4] = t2.Load(int3(clamp(cp + int2(0, 1), int2(0, 0), csize - 1), 0)).xy * up;
+    [loop] for (int i = 0; i < 5; ++i) {
+      float c = WindowCost(A, meanA, p, cand[i], inv) + 0.0005 * length(cand[i]);
+      if (c < best_cost) { best_cost = c; best = cand[i]; }
+    }
+  }
+  if (c1.w) {
+    float2 prior = t3.SampleLevel(sLinear, uv, 0).xy * asfloat(c2.xy);
+    float c = WindowCost(A, meanA, p, prior, inv) + 0.0005 * length(prior);
+    if (c < best_cost) { best_cost = c; best = prior; }
+  }
+  int r = int(c3.y);
+  [loop] for (int vy = -r; vy <= r; ++vy) {
+    [loop] for (int vx = -r; vx <= r; ++vx) {
+      float2 v = float2(vx, vy);
+      float c = WindowCost(A, meanA, p, v, inv) + 0.002 * length(v);
+      if (c < best_cost) { best_cost = c; best = v; }
+    }
+  }
+
+  // Lucas-Kanade refinement (template gradients, zero-mean residual). Flat windows have
+  // ~zero gradients and therefore don't move.
+  const float lambda = 0.002;
+  h00 += lambda;
+  h11 += lambda;
+  float det = h00 * h11 - h01 * h01;
+  float2 F = best;
+  [loop] for (int it = 0; it < 3; ++it) {
+    float B[WIN];
+    float s = 0.0;
+    [unroll] for (int k = 0; k < WIN; ++k) {
+      B[k] = t1.SampleLevel(sLinear, (float2(p + WinOffset(k)) + 0.5 + F) * inv, 0).r;
+      s += B[k];
+    }
+    float meanB = s / WIN;
+    float2 b = float2(0, 0);
+    [unroll] for (int m = 0; m < WIN; ++m) {
+      float e = (B[m] - meanB) - (A[m] - meanA);
+      b += float2(gx[m], gy[m]) * e;
+    }
+    float2 d = -float2(h11 * b.x - h01 * b.y, h00 * b.y - h01 * b.x) / det;
+    float dl = length(d);
+    if (dl > 1.0) d /= dl;
+    F += d;
+  }
+  float lk_cost = WindowCost(A, meanA, p, F, inv);
+  if (lk_cost > best_cost + 0.002) {
+    F = best;  // LK diverged
+  } else {
+    best_cost = lk_cost;
+  }
+  u0[id] = float4(F, max(best_cost, 0.0), 0);
+}
+
+// Edge-aware smoothing of a flow level: 5x5, weighted by luma similarity in A (t0),
+// match quality and distance. t1 = raw flow.
+[numthreads(8, 8, 1)] void CSSmooth(uint2 id : SV_DispatchThreadID) {
+  if (any(id >= c0.xy)) return;
+  int2 size = int2(c0.xy);
+  int2 p = int2(id);
+  float ap = LoadL(t0, p, size);
+  float2 sum = float2(0, 0);
+  float wsum = 0.0;
+  [unroll] for (int dy = -2; dy <= 2; ++dy) {
+    [unroll] for (int dx = -2; dx <= 2; ++dx) {
+      int2 q = clamp(p + int2(dx, dy), int2(0, 0), size - 1);
+      float4 f = t1.Load(int3(q, 0));
+      float dl = LoadL(t0, q, size) - ap;
+      float w = exp(-dl * dl * 312.5) * exp(-float(dx * dx + dy * dy) * 0.125) /
+                (f.z + 0.02);
+      sum += f.xy * w;
+      wsum += w;
+    }
+  }
+  u0[id] = float4(sum / wsum, t1.Load(int3(p, 0)).z, 0);
+}
+
+// ---- synthesis --------------------------------------------------------------------
+// t0 = previous frame, t1 = current frame, t2 = flow prev->cur, t3 = flow cur->prev
+// (level 0). c0.xy = output size, c2.xy = flow scale to output pixels (asfloat),
+// c3.x = debug split.
+float2 FlowAt(Texture2D<float4> t, float2 pos, float2 inv, float2 scale) {
+  return t.SampleLevel(sLinear, pos * inv, 0).xy * scale;
+}
+float3 Col(Texture2D<float4> t, float2 pos, float2 inv) {
+  return t.SampleLevel(sLinear, pos * inv, 0).rgb;
+}
+float Diff3(float3 a, float3 b) { return dot(abs(a - b), 1.0 / 3.0); }
+
+[numthreads(8, 8, 1)] void CSSynth(uint2 id : SV_DispatchThreadID) {
+  if (any(id >= c0.xy)) return;
+  float2 inv = 1.0 / float2(c0.xy);
+  float2 fs = asfloat(c2.xy);
+  float2 p = float2(id) + 0.5;
+
+  // Flows from the midpoint (linear-motion approximation, t = 0.5).
+  float2 f01 = FlowAt(t2, p, inv, fs);
+  float2 f10 = FlowAt(t3, p, inv, fs);
+  float2 y0 = p + 0.25 * (f10 - f01);
+  float2 y1 = p + 0.25 * (f01 - f10);
+
+  // Forward-backward consistency of each source sample (occlusion).
+  float2 a01 = FlowAt(t2, y0, inv, fs);
+  float e0 = length(a01 + FlowAt(t3, y0 + a01, inv, fs));
+  float2 a10 = FlowAt(t3, y1, inv, fs);
+  float e1 = length(a10 + FlowAt(t2, y1 + a10, inv, fs));
+  float s0 = 1.5 + 0.05 * length(a01), s1 = 1.5 + 0.05 * length(a10);
+  float v0 = max(exp(-e0 * e0 / (2.0 * s0 * s0)), 0.02);
+  float v1 = max(exp(-e1 * e1 / (2.0 * s1 * s1)), 0.02);
+
+  const float2 d = float2(1.5, 1.5);
+  float3 c0s = Col(t0, y0, inv), c1s = Col(t1, y1, inv);
+  float3 flow_res = (v0 * c0s + v1 * c1s) / (v0 + v1);
+  float e_flow = (Diff3(c0s, c1s) + Diff3(Col(t0, y0 + d, inv), Col(t1, y1 + d, inv)) +
+                  Diff3(Col(t0, y0 - d, inv), Col(t1, y1 - d, inv))) / 3.0;
+  // Where one side is occluded the two samples are expected to differ.
+  e_flow *= 2.0 * min(v0, v1) / (v0 + v1);
+
+  float3 z0 = Col(t0, p, inv), z1 = Col(t1, p, inv);
+  float e_zero = (Diff3(z0, z1) + Diff3(Col(t0, p + d, inv), Col(t1, p + d, inv)) +
+                  Diff3(Col(t0, p - d, inv), Col(t1, p - d, inv))) / 3.0;
+  float3 zero_res = 0.5 * (z0 + z1);
+  const float e_hold = 0.08;  // the newer frame wins once nothing explains the change
+
+  float e_min = min(min(e_flow, e_zero), e_hold);
+  const float s = 0.015;
+  float w_flow = exp(-(e_flow - e_min) / s);
+  float w_zero = exp(-(e_zero - e_min) / s);
+  float w_hold = exp(-(e_hold - e_min) / s);
+  float3 o = (w_flow * flow_res + w_zero * zero_res + w_hold * z1) / (w_flow + w_zero + w_hold);
+
+  if (c3.x == 1u && id.x >= c0.x / 2u) o = z1;
+  if (c3.x == 2u && id.x < c0.x / 2u) o = z1;
+  if (c3.x != 0u && id.x / 4u == c0.x / 8u) o = float3(1.0, 0.0, 1.0);
+  u0[id] = float4(o, 1.0);
+}
+)HLSL";
+
+const char* const kEntryPoints[] = {"CSLuma", "CSDown", "CSRefine", "CSSmooth", "CSSynth"};
+
+uint32_t DivUp(uint32_t a, uint32_t b) { return (a + b - 1) / b; }
+uint32_t AsUint(float f) {
+  uint32_t u;
+  std::memcpy(&u, &f, sizeof(u));
+  return u;
+}
+
+D3D12_RESOURCE_BARRIER Transition(ID3D12Resource* r, D3D12_RESOURCE_STATES before,
+                                  D3D12_RESOURCE_STATES after) {
+  D3D12_RESOURCE_BARRIER b{};
+  b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+  b.Transition.pResource = r;
+  b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+  b.Transition.StateBefore = before;
+  b.Transition.StateAfter = after;
+  return b;
+}
+
+}  // namespace
+
+D3D12FrameInterpolator::D3D12FrameInterpolator(const D3D12Provider& provider,
+                                               D3D12SubmissionTracker& paint_tracker)
+    : provider_(provider), paint_tracker_(paint_tracker) {}
+
+D3D12FrameInterpolator::~D3D12FrameInterpolator() { ReleaseTextures(); }
+
+bool D3D12FrameInterpolator::Initialize() {
+  if (initialized_) return true;
+  HMODULE compiler = LoadLibraryW(L"d3dcompiler_47.dll");
+  if (!compiler) {
+    REXLOG_ERROR("Frame generation: d3dcompiler_47.dll is not available");
+    return false;
+  }
+  auto compile = reinterpret_cast<pD3DCompile>(GetProcAddress(compiler, "D3DCompile"));
+  if (!compile) {
+    REXLOG_ERROR("Frame generation: D3DCompile not found");
+    return false;
+  }
+
+  // Root signature: b0 constants, a table of 4 SRVs + 2 UAVs, two static samplers.
+  D3D12_DESCRIPTOR_RANGE ranges[2]{};
+  ranges[0].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+  ranges[0].NumDescriptors = 4;
+  ranges[0].OffsetInDescriptorsFromTableStart = 0;
+  ranges[1].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
+  ranges[1].NumDescriptors = 2;
+  ranges[1].OffsetInDescriptorsFromTableStart = 4;
+  D3D12_ROOT_PARAMETER params[2]{};
+  params[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+  params[0].Constants.Num32BitValues = kConstantCount;
+  params[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  params[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+  params[1].DescriptorTable.NumDescriptorRanges = 2;
+  params[1].DescriptorTable.pDescriptorRanges = ranges;
+  params[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  D3D12_STATIC_SAMPLER_DESC samplers[2]{};
+  for (int i = 0; i < 2; ++i) {
+    samplers[i].Filter =
+        i ? D3D12_FILTER_MIN_MAG_MIP_POINT : D3D12_FILTER_MIN_MAG_LINEAR_MIP_POINT;
+    samplers[i].AddressU = samplers[i].AddressV = samplers[i].AddressW =
+        D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    samplers[i].MaxLOD = D3D12_FLOAT32_MAX;
+    samplers[i].ShaderRegister = i;
+    samplers[i].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  }
+  D3D12_ROOT_SIGNATURE_DESC rs{};
+  rs.NumParameters = 2;
+  rs.pParameters = params;
+  rs.NumStaticSamplers = 2;
+  rs.pStaticSamplers = samplers;
+  root_signature_.Attach(util::CreateRootSignature(provider_, rs));
+  if (!root_signature_) {
+    REXLOG_ERROR("Frame generation: failed to create the root signature");
+    return false;
+  }
+
+  for (int i = 0; i < kPassCount; ++i) {
+    Microsoft::WRL::ComPtr<ID3DBlob> code, errors;
+    HRESULT hr = compile(kShaderSource, sizeof(kShaderSource) - 1, "ng2_frame_interpolator", nullptr,
+                         nullptr, kEntryPoints[i], "cs_5_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0,
+                         &code, &errors);
+    if (FAILED(hr)) {
+      REXLOG_ERROR("Frame generation: failed to compile {}: {}", kEntryPoints[i],
+                   errors ? static_cast<const char*>(errors->GetBufferPointer()) : "?");
+      return false;
+    }
+    pipelines_[i].Attach(util::CreateComputePipeline(provider_.GetDevice(), code->GetBufferPointer(),
+                                                     code->GetBufferSize(), root_signature_.Get()));
+    if (!pipelines_[i]) {
+      REXLOG_ERROR("Frame generation: failed to create the {} pipeline", kEntryPoints[i]);
+      return false;
+    }
+  }
+
+  D3D12_DESCRIPTOR_HEAP_DESC heap_desc{};
+  heap_desc.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+  heap_desc.NumDescriptors = kHeapDescriptors;
+  heap_desc.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+  if (FAILED(provider_.GetDevice()->CreateDescriptorHeap(&heap_desc, IID_PPV_ARGS(&heap_)))) {
+    REXLOG_ERROR("Frame generation: failed to create the descriptor heap");
+    return false;
+  }
+  initialized_ = true;
+  REXLOG_INFO("Frame generation: initialized (dense optical flow)");
+  return true;
+}
+
+void D3D12FrameInterpolator::ReleaseTextures() {
+  if (width_) paint_tracker_.AwaitSubmissionCompletion(last_usage_);
+  for (auto& t : history_) t.Reset();
+  for (auto& slot : pyramid_) {
+    for (auto& t : slot) t.Reset();
+  }
+  for (auto& dir : flow_) {
+    for (auto& t : dir) t.Reset();
+  }
+  for (auto& t : flow_scratch_) t.Reset();
+  interpolated_.Reset();
+  width_ = height_ = 0;
+  frame_count_ = 0;
+  prior_valid_ = false;
+}
+
+bool D3D12FrameInterpolator::EnsureTextures(uint32_t width, uint32_t height) {
+  if (width == width_ && height == height_) return true;
+  ReleaseTextures();
+  ID3D12Device* device = provider_.GetDevice();
+  auto create = [&](uint32_t w, uint32_t h, DXGI_FORMAT format, bool uav,
+                    D3D12_RESOURCE_STATES state, Microsoft::WRL::ComPtr<ID3D12Resource>& out) {
+    D3D12_RESOURCE_DESC desc{};
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    desc.Width = std::max(w, 1u);
+    desc.Height = std::max(h, 1u);
+    desc.DepthOrArraySize = 1;
+    desc.MipLevels = 1;
+    desc.Format = format;
+    desc.SampleDesc.Count = 1;
+    desc.Flags = uav ? D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS : D3D12_RESOURCE_FLAG_NONE;
+    return SUCCEEDED(device->CreateCommittedResource(&util::kHeapPropertiesDefault,
+                                                     provider_.GetHeapFlagCreateNotZeroed(), &desc,
+                                                     state, nullptr, IID_PPV_ARGS(&out)));
+  };
+  width_ = width;
+  height_ = height;
+  const uint32_t factor =
+      std::max(1u, uint32_t(std::lround(double(width) / double(kAnalysisWidth))));
+  level_width_[0] = DivUp(width, factor);
+  level_height_[0] = DivUp(height, factor);
+  for (uint32_t l = 1; l < kLevels; ++l) {
+    level_width_[l] = DivUp(level_width_[l - 1], 2);
+    level_height_[l] = DivUp(level_height_[l - 1], 2);
+  }
+  bool ok = true;
+  for (int i = 0; i < 2; ++i) {
+    ok &= create(width, height, kColorFormat, false, kAllShaderResource, history_[i]);
+  }
+  for (uint32_t l = 0; l < kLevels; ++l) {
+    for (int i = 0; i < 2; ++i) {
+      ok &= create(level_width_[l], level_height_[l], kLumaFormat, true, kNonPixel,
+                   pyramid_[i][l]);
+      ok &= create(level_width_[l], level_height_[l], kFlowFormat, true, kNonPixel, flow_[i][l]);
+    }
+    ok &= create(level_width_[l], level_height_[l], kFlowFormat, true, kNonPixel,
+                 flow_scratch_[l]);
+  }
+  ok &= create(width, height, kColorFormat, true, kAllShaderResource, interpolated_);
+  if (!ok) {
+    REXLOG_ERROR("Frame generation: failed to create {}x{} textures", width, height);
+    ReleaseTextures();
+    return false;
+  }
+  REXLOG_INFO("Frame generation: {}x{} (flow {}x{} .. {}x{})", width, height, level_width_[0],
+              level_height_[0], level_width_[kLevels - 1], level_height_[kLevels - 1]);
+  return true;
+}
+
+void D3D12FrameInterpolator::Run(ID3D12GraphicsCommandList* command_list, Pass pass,
+                                 const Binding& binding, uint32_t thread_width,
+                                 uint32_t thread_height, const uint32_t* constants) {
+  ID3D12Device* device = provider_.GetDevice();
+  if (heap_next_ + kTableSize > kHeapDescriptors) heap_next_ = 0;
+  const uint32_t base = heap_next_;
+  heap_next_ += kTableSize;
+  D3D12_CPU_DESCRIPTOR_HANDLE cpu = heap_->GetCPUDescriptorHandleForHeapStart();
+  for (uint32_t i = 0; i < 4; ++i) {
+    ID3D12Resource* r = binding.srv[i];
+    D3D12_SHADER_RESOURCE_VIEW_DESC d{};
+    d.Format = r ? r->GetDesc().Format : kLumaFormat;
+    d.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    d.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    d.Texture2D.MipLevels = 1;
+    device->CreateShaderResourceView(r, &d, provider_.OffsetViewDescriptor(cpu, base + i));
+  }
+  for (uint32_t i = 0; i < 2; ++i) {
+    ID3D12Resource* r = i ? nullptr : binding.uav;
+    D3D12_UNORDERED_ACCESS_VIEW_DESC d{};
+    d.Format = r ? r->GetDesc().Format : kLumaFormat;
+    d.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+    device->CreateUnorderedAccessView(r, nullptr, &d,
+                                      provider_.OffsetViewDescriptor(cpu, base + 4 + i));
+  }
+
+  D3D12_RESOURCE_BARRIER b =
+      Transition(binding.uav, binding.uav_state, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  command_list->ResourceBarrier(1, &b);
+  command_list->SetPipelineState(pipelines_[pass].Get());
+  command_list->SetComputeRoot32BitConstants(0, kConstantCount, constants, 0);
+  D3D12_GPU_DESCRIPTOR_HANDLE gpu = heap_->GetGPUDescriptorHandleForHeapStart();
+  command_list->SetComputeRootDescriptorTable(1, provider_.OffsetViewDescriptor(gpu, base));
+  command_list->Dispatch(DivUp(thread_width, 8), DivUp(thread_height, 8), 1);
+  b = Transition(binding.uav, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, binding.uav_state);
+  command_list->ResourceBarrier(1, &b);
+}
+
+bool D3D12FrameInterpolator::PushFrame(ID3D12GraphicsCommandList* command_list,
+                                       ID3D12Resource* guest_frame, uint64_t paint_submission) {
+  if (!initialized_ || !guest_frame) return false;
+  D3D12_RESOURCE_DESC desc = guest_frame->GetDesc();
+  if (desc.Format != kColorFormat) return false;
+  if (!EnsureTextures(uint32_t(desc.Width), desc.Height)) return false;
+  last_usage_ = paint_submission;
+
+  const uint32_t n = frame_count_ ? (current_ ^ 1) : current_;
+  D3D12_RESOURCE_BARRIER b[2] = {
+      Transition(guest_frame, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE,
+                 D3D12_RESOURCE_STATE_COPY_SOURCE),
+      Transition(history_[n].Get(), kAllShaderResource, D3D12_RESOURCE_STATE_COPY_DEST)};
+  command_list->ResourceBarrier(2, b);
+  command_list->CopyResource(history_[n].Get(), guest_frame);
+  b[0] = Transition(guest_frame, D3D12_RESOURCE_STATE_COPY_SOURCE,
+                    D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+  b[1] = Transition(history_[n].Get(), D3D12_RESOURCE_STATE_COPY_DEST, kAllShaderResource);
+  command_list->ResourceBarrier(2, b);
+
+  ID3D12DescriptorHeap* heap = heap_.Get();
+  command_list->SetDescriptorHeaps(1, &heap);
+  command_list->SetComputeRootSignature(root_signature_.Get());
+
+  uint32_t c[kConstantCount] = {};
+  Binding bind;
+  bind.srv[0] = history_[n].Get();
+  bind.uav = pyramid_[n][0].Get();
+  c[0] = level_width_[0];
+  c[1] = level_height_[0];
+  c[2] = width_;
+  c[3] = height_;
+  Run(command_list, kPassLuma, bind, level_width_[0], level_height_[0], c);
+  for (uint32_t l = 1; l < kLevels; ++l) {
+    Binding down;
+    down.srv[0] = pyramid_[n][l - 1].Get();
+    down.uav = pyramid_[n][l].Get();
+    c[0] = level_width_[l];
+    c[1] = level_height_[l];
+    c[2] = level_width_[l - 1];
+    c[3] = level_height_[l - 1];
+    Run(command_list, kPassDown, down, level_width_[l], level_height_[l], c);
+  }
+
+  current_ = n;
+  frame_count_ = std::min(frame_count_ + 1, 2u);
+  return true;
+}
+
+bool D3D12FrameInterpolator::Interpolate(ID3D12GraphicsCommandList* command_list,
+                                         uint64_t paint_submission) {
+  if (!initialized_ || !HasPrevious()) return false;
+  last_usage_ = paint_submission;
+  const uint32_t cur = current_, prev = current_ ^ 1;
+  ID3D12DescriptorHeap* heap = heap_.Get();
+  command_list->SetDescriptorHeaps(1, &heap);
+  command_list->SetComputeRootSignature(root_signature_.Get());
+
+  // Flow in both directions, coarse to fine: 0 = previous->current, 1 = current->previous.
+  for (uint32_t dir = 0; dir < 2; ++dir) {
+    const uint32_t a = dir ? cur : prev, b = dir ? prev : cur;
+    for (int l = int(kLevels) - 1; l >= 0; --l) {
+      const bool coarsest = l == int(kLevels) - 1;
+      uint32_t c[kConstantCount] = {};
+      c[0] = level_width_[l];
+      c[1] = level_height_[l];
+      Binding refine;
+      refine.srv[0] = pyramid_[a][l].Get();
+      refine.srv[1] = pyramid_[b][l].Get();
+      if (!coarsest) {
+        refine.srv[2] = flow_[dir][l + 1].Get();
+        c[4] = level_width_[l + 1];
+        c[5] = level_height_[l + 1];
+        c[6] = 1;
+        c[10] = AsUint(float(level_width_[l]) / float(level_width_[l + 1]));
+        c[11] = AsUint(float(level_height_[l]) / float(level_height_[l + 1]));
+      }
+      if (prior_valid_) {
+        refine.srv[3] = flow_[dir][0].Get();  // the previous pair's final flow
+        c[7] = 1;
+        c[8] = AsUint(float(level_width_[l]) / float(level_width_[0]));
+        c[9] = AsUint(float(level_height_[l]) / float(level_height_[0]));
+      }
+      c[13] = coarsest ? kCoarseSearchRadius : 0;
+      refine.uav = flow_scratch_[l].Get();
+      Run(command_list, kPassRefine, refine, level_width_[l], level_height_[l], c);
+
+      Binding smooth;
+      smooth.srv[0] = pyramid_[a][l].Get();
+      smooth.srv[1] = flow_scratch_[l].Get();
+      smooth.uav = flow_[dir][l].Get();
