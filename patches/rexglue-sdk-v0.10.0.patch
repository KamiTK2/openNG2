+// NG2 ADDITION: native resolves (see VulkanTextureCache::Ng2NativeResolve).
+bool VulkanRenderTargetCache::Ng2RecordNativeResolve(const draw_util::ResolveInfo& resolve_info,
+                                                     VulkanTextureCache& texture_cache) {
+  int reason = 0;
+  auto reject = [&]() {
+    ++ng2_native_resolves_rejected_;
+    static std::unordered_set<uint64_t> logged;  // NG2 DIAG: once per destination + reason
+    if (logged.insert((uint64_t(resolve_info.copy_dest_base) << 8) | uint32_t(reason)).second) {
+      REXGPU_INFO(
+          "NG2 native resolve rejected (step {}): dest {:08X} src fmt {} msaa {} 64bpp {} "
+          "dest fmt {} num {} bias {} swap {} endian {} off {},{} base {} pitch {}",
+          reason, resolve_info.copy_dest_base, uint32_t(resolve_info.color_edram_info.format),
+          uint32_t(resolve_info.color_edram_info.msaa_samples),
+          uint32_t(resolve_info.color_edram_info.format_is_64bpp),
+          uint32_t(resolve_info.copy_dest_info.copy_dest_format),
+          uint32_t(resolve_info.copy_dest_info.copy_dest_number),
+          int32_t(resolve_info.copy_dest_info.copy_dest_exp_bias),
+          uint32_t(resolve_info.copy_dest_info.copy_dest_swap),
+          uint32_t(resolve_info.copy_dest_info.copy_dest_endian),
+          uint32_t(resolve_info.copy_dest_coordinate_info.offset_x_div_8),
+          uint32_t(resolve_info.copy_dest_coordinate_info.offset_y_div_8),
+          uint32_t(resolve_info.color_edram_info.base_tiles),
+          uint32_t(resolve_info.color_edram_info.pitch_tiles));
+    }
+    return false;
+  };
+  if (GetPath() != Path::kHostRenderTargets || !IsDrawResolutionScaled() ||
+      resolve_info.IsCopyingDepth()) {
+    return (reason = 1, reject());
+  }
+  const draw_util::ResolveEdramInfo edram_info = resolve_info.color_edram_info;
+  const reg::RB_COPY_DEST_INFO dest_info = resolve_info.copy_dest_info;
+  bool resolve_2x = edram_info.msaa_samples == xenos::MsaaSamples::k2X;
+  if ((edram_info.msaa_samples != xenos::MsaaSamples::k1X && !resolve_2x) ||
+      edram_info.format_is_64bpp ||
+      dest_info.copy_dest_exp_bias != 0 || dest_info.copy_dest_array ||
+      resolve_info.copy_dest_coordinate_info.offset_x_div_8 ||
+      resolve_info.copy_dest_coordinate_info.offset_y_div_8 ||
+      uint32_t(dest_info.copy_dest_endian) >= 4) {
+    return (reason = 2, reject());
+  }
+  // Supported conversions (done by a blit, which converts by value; a red/blue swap blits
+  // into a B8G8R8A8 snapshot whose bytes are then copied raw into the R8G8B8A8 texture):
+  //   8888 -> 8888 (unorm), 7e3 -> 8888 (unorm, clamped), 7e3 -> 16_16_16_16_FLOAT.
+  auto rt_format = xenos::ColorRenderTargetFormat(edram_info.format);
+  bool rt_7e3 = rt_format == xenos::ColorRenderTargetFormat::k_2_10_10_10_FLOAT ||
+                rt_format == xenos::ColorRenderTargetFormat::k_2_10_10_10_FLOAT_AS_16_16_16_16;
+  bool rt_8888 = rt_format == xenos::ColorRenderTargetFormat::k_8_8_8_8;
+  auto texture_format = xenos::TextureFormat(uint32_t(dest_info.copy_dest_format));
+  VkFormat host_format = texture_cache.Ng2GetTextureHostFormat(texture_format);
+  VkFormat image_format = VK_FORMAT_UNDEFINED;
+  if ((rt_8888 || rt_7e3) && dest_info.copy_dest_format == xenos::ColorFormat::k_8_8_8_8 &&
+      uint32_t(dest_info.copy_dest_number) == 0 && host_format == VK_FORMAT_R8G8B8A8_UNORM) {
+    image_format = dest_info.copy_dest_swap ? VK_FORMAT_B8G8R8A8_UNORM : VK_FORMAT_R8G8B8A8_UNORM;
+  } else if (rt_7e3 && dest_info.copy_dest_format == xenos::ColorFormat::k_16_16_16_16_FLOAT &&
+             !dest_info.copy_dest_swap && host_format == VK_FORMAT_R16G16B16A16_SFLOAT) {
+    image_format = VK_FORMAT_R16G16B16A16_SFLOAT;
+  }
+  if (image_format == VK_FORMAT_UNDEFINED) {
+    return (reason = 3, reject());
+  }
+  VkFormat rt_host_format = GetColorVulkanFormat(rt_format);
+  if (rt_host_format == VK_FORMAT_UNDEFINED) {
+    return (reason = 4, reject());
+  }
+
+  // One render target must own the whole resolved span.
+  uint32_t span_base, span_row_length, span_rows, span_pitch;
+  resolve_info.GetCopyEdramTileSpan(span_base, span_row_length, span_rows, span_pitch);
+  GetResolveCopyRectanglesToDump(span_base, span_row_length, span_rows, span_pitch,
+                                 dump_rectangles_);
+  if (dump_rectangles_.size() != 1) {
+    return (reason = 5, reject());
+  }
+  const ResolveCopyDumpRectangle& rectangle = dump_rectangles_[0];
+  if (!rectangle.render_target || rectangle.row_first != 0 || rectangle.rows != span_rows ||
+      rectangle.row_first_start != 0 ||
+      rectangle.row_last_end != (span_rows > 1 ? span_row_length : span_row_length)) {
+    return (reason = 6, reject());
+  }
+  auto& rt = *static_cast<VulkanRenderTarget*>(rectangle.render_target);
+  RenderTargetKey rt_key = rt.key();
+  // A 4x MSAA owner read as 1x (samples as pixels) needs the compute unpack (16F only).
+  bool msaa_unpack = false;
+  if (rt_key.is_depth || rt_key.Is64bpp()) {
+    return (reason = 70, reject());
+  }
+  // A 2x resolve (sample select / average) from a 2x owner also goes through the compute path.
+  bool msaa_select = false;
+  // A 2x resolve of tiles owned by a 4x surface (horizontal samples read as pixels).
+  bool msaa_4x_as_2x = false;
+  // A 2x resolve of tiles owned by a 1x surface that stores a 4x one (ng2_msaa_supersample):
+  // 2x pixel (x, y) sample g = 1x pixel (x, 2y + g).
+  bool msaa_1x_as_2x = false;
+  if (resolve_2x) {
+    msaa_4x_as_2x = rt_key.msaa_samples == xenos::MsaaSamples::k4X;
+    msaa_1x_as_2x =
+        rt_key.msaa_samples == xenos::MsaaSamples::k1X && Ng2MsaaSupersampleEnabled();
+    if ((rt_key.msaa_samples != xenos::MsaaSamples::k2X && !msaa_4x_as_2x && !msaa_1x_as_2x) ||
+        image_format != VK_FORMAT_R16G16B16A16_SFLOAT ||
+        rt_host_format != VK_FORMAT_R16G16B16A16_SFLOAT || !Ng2InitMsaaUnpack()) {
+      return (reason = 730 + int(rt_key.msaa_samples) * 10 +
+                       int(image_format == VK_FORMAT_R16G16B16A16_SFLOAT) * 2 +
+                       int(rt_host_format == VK_FORMAT_R16G16B16A16_SFLOAT),
+              reject());
+    }
+    msaa_select = true;
+  } else if (rt_key.msaa_samples == xenos::MsaaSamples::k4X) {
+    if (image_format != VK_FORMAT_R16G16B16A16_SFLOAT ||
+        rt_host_format != VK_FORMAT_R16G16B16A16_SFLOAT || !Ng2InitMsaaUnpack()) {
+      return (reason = 72, reject());
+    }
+    msaa_unpack = true;
+  } else if (rt_key.msaa_samples != xenos::MsaaSamples::k1X) {
+    return (reason = 71, reject());
+  }
+  if (rt_key.pitch_tiles_at_32bpp != edram_info.pitch_tiles) {
+    return (reason = 75, reject());
+  }
+  if (GetColorVulkanFormat(rt_key.GetColorFormat()) != rt_host_format) {
+    return (reason = 76, reject());
+  }
+
+  // Source rectangle in the render target (32bpp 1x: 80x16 pixel tiles).
+  uint32_t pitch = edram_info.pitch_tiles;
+  uint32_t delta = (edram_info.base_tiles + xenos::kEdramTileCount - rt_key.base_tiles) %
+                   xenos::kEdramTileCount;
+  uint32_t src_x = (delta % pitch) * xenos::kEdramTileWidthSamples +
+                   resolve_info.coordinate_info.edram_offset_x_div_8 * 8;
+  uint32_t src_y = (delta / pitch) * (xenos::kEdramTileHeightSamples >> uint32_t(resolve_2x)) +
+                   resolve_info.coordinate_info.edram_offset_y_div_8 * 8;
+  uint32_t width = resolve_info.coordinate_info.width_div_8 * 8;
+  uint32_t height = resolve_info.height_div_8 * 8;
+  uint32_t scale_x = draw_resolution_scale_x(), scale_y = draw_resolution_scale_y();
+  // In 1x-view pixels (twice the 4x surface's size in both directions when unpacking).
+  uint32_t view_factor_x = (msaa_unpack || msaa_4x_as_2x) ? 2 : 1;
+  uint32_t view_factor_y = msaa_unpack ? 2 : 1;
+  uint32_t rt_width = rt_key.GetWidth() * scale_x * view_factor_x;
+  uint32_t rt_height = GetRenderTargetHeight(rt_key.pitch_tiles_at_32bpp, rt_key.msaa_samples) *
+                       scale_y * view_factor_y;
+  if (msaa_1x_as_2x) {
+    rt_height /= 2;  // two 1x rows per 2x row
+  }
+  if (!width || !height || (src_x + width) * scale_x > rt_width ||
+      (src_y + height) * scale_y > rt_height) {
+    return (reason = 8, reject());
+  }
+
+  VulkanTextureCache::Ng2NativeResolve* entry = texture_cache.Ng2AcquireNativeResolve(
+      resolve_info.copy_dest_base, host_format, image_format, width * scale_x, height * scale_y);
+  if (!entry) {
+    return (reason = 9, reject());
+  }
+  entry->extent_start = resolve_info.copy_dest_extent_start;
+  entry->extent_length = resolve_info.copy_dest_extent_length;
+  entry->pitch_div_32 = resolve_info.copy_dest_coordinate_info.pitch_aligned_div_32;
+  entry->width = width;
+  entry->height = height;
+  entry->format = texture_format;
+  entry->endian = uint32_t(dest_info.copy_dest_endian);
+
+  if (msaa_unpack || msaa_select) {
+    const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+    const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+    const VkDevice device = vulkan_device->device();
+    if (entry->storage_view == VK_NULL_HANDLE) {
+      VkImageViewCreateInfo view_info = {};
+      view_info.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
+      view_info.image = entry->image;
+      view_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+      view_info.format = VK_FORMAT_R16G16B16A16_SFLOAT;
+      view_info.subresourceRange = ui::vulkan::util::InitializeSubresourceRange();
+      if (dfn.vkCreateImageView(device, &view_info, nullptr, &entry->storage_view) !=
+          VK_SUCCESS) {
+        entry->storage_view = VK_NULL_HANDLE;
+        return (reason = 77, reject());
+      }
+    }
+    if (entry->storage_set == VK_NULL_HANDLE) {
+      VkDescriptorSetAllocateInfo set_info = {};
+      set_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+      set_info.descriptorPool = ng2_msaa_unpack_pool_;
+      set_info.descriptorSetCount = 1;
+      set_info.pSetLayouts = &ng2_msaa_unpack_storage_layout_;
+      if (dfn.vkAllocateDescriptorSets(device, &set_info, &entry->storage_set) != VK_SUCCESS) {
+        entry->storage_set = VK_NULL_HANDLE;
+        return (reason = 78, reject());
+      }
+      VkDescriptorImageInfo image_info = {};
+      image_info.imageView = entry->storage_view;
+      image_info.imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+      VkWriteDescriptorSet write = {};
+      write.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+      write.dstSet = entry->storage_set;
+      write.descriptorCount = 1;
+      write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+      write.pImageInfo = &image_info;
+      dfn.vkUpdateDescriptorSets(device, 1, &write, 0, nullptr);
+    }
+    command_processor_.PushImageMemoryBarrier(
+        rt.image(), ui::vulkan::util::InitializeSubresourceRange(), rt.current_stage_mask(),
+        VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, rt.current_access_mask(), VK_ACCESS_SHADER_READ_BIT,
+        rt.current_layout(), VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+    rt.SetUsage(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT,
+                VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+    command_processor_.PushImageMemoryBarrier(
+        entry->image, ui::vulkan::util::InitializeSubresourceRange(),
+        VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+        VK_ACCESS_TRANSFER_READ_BIT, VK_ACCESS_SHADER_WRITE_BIT, VK_IMAGE_LAYOUT_UNDEFINED,
+        VK_IMAGE_LAYOUT_GENERAL);
+    command_processor_.SubmitBarriers(true);
+    bool source_uint = rt.view_color_transfer_separate() != VK_NULL_HANDLE;
+    command_processor_.BindExternalComputePipeline(
+        ng2_msaa_unpack_pipelines_[uint32_t(source_uint) + 2 * uint32_t(msaa_1x_as_2x)]);
+    VkDescriptorSet sets[2] = {rt.GetDescriptorSetTransferSource(), entry->storage_set};
+    DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+    command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+                                           ng2_msaa_unpack_pipeline_layout_, 0, 2, sets, 0,
+                                           nullptr);
+    // Mode 0: 4x surface read as 1x (samples to pixels). Mode 1: average of host samples
+    // [sample_a, sample_b] (equal for a single sample) at the same pixel.
+    int32_t mode = 0, sample_a = 0, sample_b = 0;
+    if (msaa_select) {
+      mode = msaa_1x_as_2x ? 3 : (msaa_4x_as_2x ? 2 : 1);
+      auto to_host = [this, msaa_4x_as_2x, msaa_1x_as_2x](uint32_t guest_sample) {
+        if (msaa_4x_as_2x || msaa_1x_as_2x) {
+          return int32_t(guest_sample);  // the shader builds the 4x sample index
+        }
+        // Same as the 2x transfers: native 2x swaps the two samples, 2x-as-4x uses 0 and 3.
+        return int32_t(msaa_2x_attachments_supported_ ? (guest_sample ^ 1)
+                                                      : (guest_sample ? 3 : 0));
+      };
+      switch (resolve_info.copy_dest_coordinate_info.copy_sample_select) {
+        case xenos::CopySampleSelect::k0:
+          sample_a = sample_b = to_host(0);
+          break;
+        case xenos::CopySampleSelect::k1:
+          sample_a = sample_b = to_host(1);
+          break;
+        case xenos::CopySampleSelect::k01:
+        case xenos::CopySampleSelect::k0123:
+          sample_a = to_host(0);
+          sample_b = to_host(1);
+          break;
+        default:
+          return (reason = 79, reject());
+      }
+    }
+    int32_t constants[8] = {int32_t(src_x * scale_x), int32_t(src_y * scale_y),
+                            int32_t(width * scale_x), int32_t(height * scale_y),
+                            mode, sample_a, sample_b, 0};
+    command_buffer.CmdVkPushConstants(ng2_msaa_unpack_pipeline_layout_,
+                                      VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(constants),
+                                      constants);
+    command_buffer.CmdVkDispatch((width * scale_x + 7) / 8, (height * scale_y + 7) / 8, 1);
+    entry->layout = VK_IMAGE_LAYOUT_GENERAL;
+    entry->write_stage = VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT;
+    entry->write_access = VK_ACCESS_SHADER_WRITE_BIT;
+    entry->valid = true;
+    ++ng2_native_resolves_recorded_;
+    return true;
+  }
+
+  // Render target -> transfer source, snapshot -> transfer destination.
+  command_processor_.PushImageMemoryBarrier(
+      rt.image(), ui::vulkan::util::InitializeSubresourceRange(), rt.current_stage_mask(),
+      VK_PIPELINE_STAGE_TRANSFER_BIT, rt.current_access_mask(), VK_ACCESS_TRANSFER_READ_BIT,
+      rt.current_layout(), VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  rt.SetUsage(VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+              VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  command_processor_.PushImageMemoryBarrier(
+      entry->image, ui::vulkan::util::InitializeSubresourceRange(),
+      VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+      VK_ACCESS_TRANSFER_WRITE_BIT, VK_IMAGE_LAYOUT_UNDEFINED,
+      VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
