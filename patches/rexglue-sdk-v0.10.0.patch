+D3D12FrameInterpolator::D3D12FrameInterpolator(const D3D12Provider& provider,
+                                               D3D12SubmissionTracker& paint_tracker)
+    : provider_(provider), paint_tracker_(paint_tracker) {}
+
+D3D12FrameInterpolator::~D3D12FrameInterpolator() { ReleaseTextures(); }
+
+bool D3D12FrameInterpolator::Initialize() {
+  if (initialized_) return true;
+  HMODULE compiler = LoadLibraryW(L"d3dcompiler_47.dll");
+  if (!compiler) {
+    REXLOG_ERROR("Frame generation: d3dcompiler_47.dll is not available");
+    return false;
+  }
+  auto compile = reinterpret_cast<pD3DCompile>(GetProcAddress(compiler, "D3DCompile"));
+  if (!compile) {
+    REXLOG_ERROR("Frame generation: D3DCompile not found");
+    return false;
+  }
+
+  // Root signature: b0 constants, a table of 4 SRVs + 2 UAVs, two static samplers.
+  D3D12_DESCRIPTOR_RANGE ranges[2]{};
+  ranges[0].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+  ranges[0].NumDescriptors = 4;
+  ranges[0].OffsetInDescriptorsFromTableStart = 0;
+  ranges[1].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
+  ranges[1].NumDescriptors = 2;
+  ranges[1].OffsetInDescriptorsFromTableStart = 4;
+  D3D12_ROOT_PARAMETER params[2]{};
+  params[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+  params[0].Constants.Num32BitValues = kConstantCount;
+  params[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  params[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+  params[1].DescriptorTable.NumDescriptorRanges = 2;
+  params[1].DescriptorTable.pDescriptorRanges = ranges;
+  params[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  D3D12_STATIC_SAMPLER_DESC samplers[2]{};
+  for (int i = 0; i < 2; ++i) {
+    samplers[i].Filter =
+        i ? D3D12_FILTER_MIN_MAG_MIP_POINT : D3D12_FILTER_MIN_MAG_LINEAR_MIP_POINT;
+    samplers[i].AddressU = samplers[i].AddressV = samplers[i].AddressW =
+        D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    samplers[i].MaxLOD = D3D12_FLOAT32_MAX;
+    samplers[i].ShaderRegister = i;
+    samplers[i].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  }
+  D3D12_ROOT_SIGNATURE_DESC rs{};
+  rs.NumParameters = 2;
+  rs.pParameters = params;
+  rs.NumStaticSamplers = 2;
+  rs.pStaticSamplers = samplers;
+  root_signature_.Attach(util::CreateRootSignature(provider_, rs));
+  if (!root_signature_) {
+    REXLOG_ERROR("Frame generation: failed to create the root signature");
+    return false;
+  }
+
+  for (int i = 0; i < kPassCount; ++i) {
+    Microsoft::WRL::ComPtr<ID3DBlob> code, errors;
+    HRESULT hr = compile(kShaderSource, sizeof(kShaderSource) - 1, "ng2_frame_interpolator", nullptr,
+                         nullptr, kEntryPoints[i], "cs_5_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0,
+                         &code, &errors);
+    if (FAILED(hr)) {
+      REXLOG_ERROR("Frame generation: failed to compile {}: {}", kEntryPoints[i],
+                   errors ? static_cast<const char*>(errors->GetBufferPointer()) : "?");
+      return false;
+    }
+    pipelines_[i].Attach(util::CreateComputePipeline(provider_.GetDevice(), code->GetBufferPointer(),
+                                                     code->GetBufferSize(), root_signature_.Get()));
+    if (!pipelines_[i]) {
+      REXLOG_ERROR("Frame generation: failed to create the {} pipeline", kEntryPoints[i]);
+      return false;
+    }
+  }
+
+  D3D12_DESCRIPTOR_HEAP_DESC heap_desc{};
+  heap_desc.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+  heap_desc.NumDescriptors = kHeapDescriptors;
+  heap_desc.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+  if (FAILED(provider_.GetDevice()->CreateDescriptorHeap(&heap_desc, IID_PPV_ARGS(&heap_)))) {
+    REXLOG_ERROR("Frame generation: failed to create the descriptor heap");
+    return false;
+  }
+  initialized_ = true;
+  REXLOG_INFO("Frame generation: initialized (dense optical flow)");
+  return true;
+}
+
+void D3D12FrameInterpolator::ReleaseTextures() {
+  if (width_) paint_tracker_.AwaitSubmissionCompletion(last_usage_);
+  for (auto& t : history_) t.Reset();
+  for (auto& slot : pyramid_) {
+    for (auto& t : slot) t.Reset();
+  }
+  for (auto& dir : flow_) {
+    for (auto& t : dir) t.Reset();
+  }
+  for (auto& t : flow_scratch_) t.Reset();
+  interpolated_.Reset();
+  width_ = height_ = 0;
+  frame_count_ = 0;
+  prior_valid_ = false;
+}
+
+bool D3D12FrameInterpolator::EnsureTextures(uint32_t width, uint32_t height) {
+  if (width == width_ && height == height_) return true;
+  ReleaseTextures();
+  ID3D12Device* device = provider_.GetDevice();
+  auto create = [&](uint32_t w, uint32_t h, DXGI_FORMAT format, bool uav,
+                    D3D12_RESOURCE_STATES state, Microsoft::WRL::ComPtr<ID3D12Resource>& out) {
+    D3D12_RESOURCE_DESC desc{};
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    desc.Width = std::max(w, 1u);
+    desc.Height = std::max(h, 1u);
+    desc.DepthOrArraySize = 1;
+    desc.MipLevels = 1;
+    desc.Format = format;
+    desc.SampleDesc.Count = 1;
+    desc.Flags = uav ? D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS : D3D12_RESOURCE_FLAG_NONE;
+    return SUCCEEDED(device->CreateCommittedResource(&util::kHeapPropertiesDefault,
+                                                     provider_.GetHeapFlagCreateNotZeroed(), &desc,
+                                                     state, nullptr, IID_PPV_ARGS(&out)));
+  };
+  width_ = width;
+  height_ = height;
+  const uint32_t factor =
+      std::max(1u, uint32_t(std::lround(double(width) / double(kAnalysisWidth))));
+  level_width_[0] = DivUp(width, factor);
+  level_height_[0] = DivUp(height, factor);
+  for (uint32_t l = 1; l < kLevels; ++l) {
+    level_width_[l] = DivUp(level_width_[l - 1], 2);
+    level_height_[l] = DivUp(level_height_[l - 1], 2);
+  }
+  bool ok = true;
+  for (int i = 0; i < 2; ++i) {
+    ok &= create(width, height, kColorFormat, true, kAllShaderResource, history_[i]);
+  }
+  for (uint32_t l = 0; l < kLevels; ++l) {
+    for (int i = 0; i < 2; ++i) {
+      ok &= create(level_width_[l], level_height_[l], kLumaFormat, true, kNonPixel,
+                   pyramid_[i][l]);
+      ok &= create(level_width_[l], level_height_[l], kFlowFormat, true, kNonPixel, flow_[i][l]);
+    }
+    ok &= create(level_width_[l], level_height_[l], kFlowFormat, true, kNonPixel,
+                 flow_scratch_[l]);
+  }
+  ok &= create(width, height, kColorFormat, true, kAllShaderResource, interpolated_);
+  if (!ok) {
+    REXLOG_ERROR("Frame generation: failed to create {}x{} textures", width, height);
+    ReleaseTextures();
+    return false;
+  }
+  REXLOG_INFO("Frame generation: {}x{} (flow {}x{} .. {}x{})", width, height, level_width_[0],
+              level_height_[0], level_width_[kLevels - 1], level_height_[kLevels - 1]);
+  return true;
+}
+
+void D3D12FrameInterpolator::Run(ID3D12GraphicsCommandList* command_list, Pass pass,
+                                 const Binding& binding, uint32_t thread_width,
+                                 uint32_t thread_height, const uint32_t* constants) {
+  ID3D12Device* device = provider_.GetDevice();
+  if (heap_next_ + kTableSize > kHeapDescriptors) heap_next_ = 0;
+  const uint32_t base = heap_next_;
+  heap_next_ += kTableSize;
+  D3D12_CPU_DESCRIPTOR_HANDLE cpu = heap_->GetCPUDescriptorHandleForHeapStart();
+  for (uint32_t i = 0; i < 4; ++i) {
+    ID3D12Resource* r = binding.srv[i];
+    D3D12_SHADER_RESOURCE_VIEW_DESC d{};
+    d.Format = r ? r->GetDesc().Format : kLumaFormat;
+    d.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    d.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    d.Texture2D.MipLevels = 1;
+    device->CreateShaderResourceView(r, &d, provider_.OffsetViewDescriptor(cpu, base + i));
+  }
+  for (uint32_t i = 0; i < 2; ++i) {
+    ID3D12Resource* r = i ? nullptr : binding.uav;
+    D3D12_UNORDERED_ACCESS_VIEW_DESC d{};
+    d.Format = r ? r->GetDesc().Format : kLumaFormat;
+    d.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+    device->CreateUnorderedAccessView(r, nullptr, &d,
+                                      provider_.OffsetViewDescriptor(cpu, base + 4 + i));
+  }
+
+  D3D12_RESOURCE_BARRIER b =
+      Transition(binding.uav, binding.uav_state, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  command_list->ResourceBarrier(1, &b);
+  command_list->SetPipelineState(pipelines_[pass].Get());
+  command_list->SetComputeRoot32BitConstants(0, kConstantCount, constants, 0);
+  D3D12_GPU_DESCRIPTOR_HANDLE gpu = heap_->GetGPUDescriptorHandleForHeapStart();
+  command_list->SetComputeRootDescriptorTable(1, provider_.OffsetViewDescriptor(gpu, base));
+  command_list->Dispatch(DivUp(thread_width, 8), DivUp(thread_height, 8), 1);
+  b = Transition(binding.uav, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, binding.uav_state);
+  command_list->ResourceBarrier(1, &b);
+}
+
+bool D3D12FrameInterpolator::PushFrame(ID3D12GraphicsCommandList* command_list,
+                                       ID3D12Resource* guest_frame, uint64_t paint_submission,
+                                       uint32_t max_width, uint32_t max_height) {
+  if (!initialized_ || !guest_frame) return false;
+  D3D12_RESOURCE_DESC desc = guest_frame->GetDesc();
+  if (desc.Format != kColorFormat) return false;
+  // Working size: the guest frame, or fitted inside the swap chain if it is larger.
+  const uint32_t guest_width = uint32_t(desc.Width), guest_height = desc.Height;
+  uint32_t width = guest_width, height = guest_height;
+  if (max_width && max_height && (guest_width > max_width || guest_height > max_height)) {
+    const double scale = std::min(double(max_width) / guest_width, double(max_height) / guest_height);
+    width = std::max(1u, uint32_t(std::lround(guest_width * scale)));
+    height = std::max(1u, uint32_t(std::lround(guest_height * scale)));
+  }
+  if (!EnsureTextures(width, height)) return false;
+  last_usage_ = paint_submission;
+
+  const uint32_t n = frame_count_ ? (current_ ^ 1) : current_;
+  ID3D12DescriptorHeap* heap = heap_.Get();
+  uint32_t c[kConstantCount] = {};
+  if (width == guest_width && height == guest_height) {
+    D3D12_RESOURCE_BARRIER b[2] = {
+        Transition(guest_frame, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE,
+                   D3D12_RESOURCE_STATE_COPY_SOURCE),
+        Transition(history_[n].Get(), kAllShaderResource, D3D12_RESOURCE_STATE_COPY_DEST)};
+    command_list->ResourceBarrier(2, b);
+    command_list->CopyResource(history_[n].Get(), guest_frame);
+    b[0] = Transition(guest_frame, D3D12_RESOURCE_STATE_COPY_SOURCE,
+                      D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    b[1] = Transition(history_[n].Get(), D3D12_RESOURCE_STATE_COPY_DEST, kAllShaderResource);
+    command_list->ResourceBarrier(2, b);
+    command_list->SetDescriptorHeaps(1, &heap);
+    command_list->SetComputeRootSignature(root_signature_.Get());
+  } else {
+    D3D12_RESOURCE_BARRIER b = Transition(guest_frame, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE,
+                                          kAllShaderResource);
+    command_list->ResourceBarrier(1, &b);
+    command_list->SetDescriptorHeaps(1, &heap);
+    command_list->SetComputeRootSignature(root_signature_.Get());
+    Binding resample;
+    resample.srv[0] = guest_frame;
+    resample.uav = history_[n].Get();
+    resample.uav_state = kAllShaderResource;
+    c[0] = width;
+    c[1] = height;
+    c[2] = guest_width;
+    c[3] = guest_height;
+    Run(command_list, kPassResample, resample, width, height, c);
+    b = Transition(guest_frame, kAllShaderResource, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    command_list->ResourceBarrier(1, &b);
+  }
+
+  Binding bind;
+  bind.srv[0] = history_[n].Get();
+  bind.uav = pyramid_[n][0].Get();
+  c[0] = level_width_[0];
+  c[1] = level_height_[0];
+  c[2] = width_;
+  c[3] = height_;
+  Run(command_list, kPassLuma, bind, level_width_[0], level_height_[0], c);
+  for (uint32_t l = 1; l < kLevels; ++l) {
+    Binding down;
+    down.srv[0] = pyramid_[n][l - 1].Get();
+    down.uav = pyramid_[n][l].Get();
+    c[0] = level_width_[l];
+    c[1] = level_height_[l];
+    c[2] = level_width_[l - 1];
+    c[3] = level_height_[l - 1];
+    Run(command_list, kPassDown, down, level_width_[l], level_height_[l], c);
+  }
+
+  current_ = n;
+  frame_count_ = std::min(frame_count_ + 1, 2u);
+  return true;
+}
+
+bool D3D12FrameInterpolator::Interpolate(ID3D12GraphicsCommandList* command_list,
+                                         uint64_t paint_submission) {
+  if (!initialized_ || !HasPrevious()) return false;
+  last_usage_ = paint_submission;
+  const uint32_t cur = current_, prev = current_ ^ 1;
+  ID3D12DescriptorHeap* heap = heap_.Get();
+  command_list->SetDescriptorHeaps(1, &heap);
+  command_list->SetComputeRootSignature(root_signature_.Get());
+
+  // Flow in both directions, coarse to fine: 0 = previous->current, 1 = current->previous.
+  for (uint32_t dir = 0; dir < 2; ++dir) {
+    const uint32_t a = dir ? cur : prev, b = dir ? prev : cur;
+    for (int l = int(kLevels) - 1; l >= 0; --l) {
+      const bool coarsest = l == int(kLevels) - 1;
+      uint32_t c[kConstantCount] = {};
+      c[0] = level_width_[l];
+      c[1] = level_height_[l];
+      Binding refine;
+      refine.srv[0] = pyramid_[a][l].Get();
+      refine.srv[1] = pyramid_[b][l].Get();
+      if (!coarsest) {
+        refine.srv[2] = flow_[dir][l + 1].Get();
+        c[4] = level_width_[l + 1];
+        c[5] = level_height_[l + 1];
+        c[6] = 1;
+        c[10] = AsUint(float(level_width_[l]) / float(level_width_[l + 1]));
+        c[11] = AsUint(float(level_height_[l]) / float(level_height_[l + 1]));
+      }
+      if (prior_valid_) {
+        refine.srv[3] = flow_[dir][0].Get();  // the previous pair's final flow
+        c[7] = 1;
+        c[8] = AsUint(float(level_width_[l]) / float(level_width_[0]));
+        c[9] = AsUint(float(level_height_[l]) / float(level_height_[0]));
+      }
+      c[13] = coarsest ? kCoarseSearchRadius : 0;
+      refine.uav = flow_scratch_[l].Get();
+      Run(command_list, kPassRefine, refine, level_width_[l], level_height_[l], c);
+
+      Binding smooth;
+      smooth.srv[0] = pyramid_[a][l].Get();
+      smooth.srv[1] = flow_scratch_[l].Get();
+      smooth.uav = flow_[dir][l].Get();
+      Run(command_list, kPassSmooth, smooth, level_width_[l], level_height_[l], c);
+    }
+  }
+
+  uint32_t c[kConstantCount] = {};
+  c[0] = width_;
+  c[1] = height_;
+  c[4] = level_width_[0];
+  c[5] = level_height_[0];
+  c[8] = AsUint(float(width_) / float(level_width_[0]));
+  c[9] = AsUint(float(height_) / float(level_height_[0]));
+  c[12] = debug_split_;
+  Binding synth;
+  synth.srv[0] = history_[prev].Get();
+  synth.srv[1] = history_[cur].Get();
+  synth.srv[2] = flow_[0][0].Get();
+  synth.srv[3] = flow_[1][0].Get();
+  synth.uav = interpolated_.Get();
+  synth.uav_state = kAllShaderResource;
+  Run(command_list, kPassSynth, synth, width_, height_, c);
+  prior_valid_ = true;
+  return true;
+}
+
