+    if (!delayed_paint_pending_) {
+      delayed_paint_condition_.wait(lock);
+      continue;
+    }
+    // Sleep until shortly before the deadline (OS wake-ups run ~0.5 ms late), then spin.
+    auto early = delayed_paint_deadline_ - std::chrono::microseconds(700);
+    if (std::chrono::steady_clock::now() < early &&
+        delayed_paint_condition_.wait_until(lock, early) != std::cv_status::timeout) {
+      continue;  // re-check: shutdown or a new deadline
+    }
+    if (!delayed_paint_pending_ || delayed_paint_shutdown_) continue;
+    if (std::chrono::steady_clock::now() < delayed_paint_deadline_) {
+      lock.unlock();
+      std::this_thread::yield();
+      lock.lock();
+      continue;
+    }
+    delayed_paint_pending_ = false;
+    {
+      // NG2 DIAG: how late the delayed paint fires.
+      static double late_sum = 0.0, late_max = 0.0;
+      static uint32_t late_n = 0, late_over1ms = 0;
+      static auto late_last = std::chrono::steady_clock::now();
+      auto now = std::chrono::steady_clock::now();
+      double late_us =
+          std::chrono::duration<double, std::micro>(now - delayed_paint_deadline_).count();
+      late_sum += late_us;
+      late_max = std::max(late_max, late_us);
+      ++late_n;
+      if (late_us > 1000.0) ++late_over1ms;
+      if (now - late_last >= std::chrono::seconds(5)) {
+        if (REXCVAR_GET(ng2_diag_log)) REXLOG_INFO("NG2DIAG delayed paint lateness: avg {:.0f}us max {:.0f}us, >1ms {}/{}",
+                    late_sum / late_n, late_max, late_over1ms, late_n);
+        late_sum = late_max = 0.0;
+        late_n = late_over1ms = 0;
+        late_last = now;
