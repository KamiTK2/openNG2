diff --git a/include/rex/ui/d3d12/d3d12_frame_interpolator.h b/include/rex/ui/d3d12/d3d12_frame_interpolator.h
new file mode 100644
index 0000000..a3fe6d0
--- /dev/null
+++ b/include/rex/ui/d3d12/d3d12_frame_interpolator.h
@@ -0,0 +1,113 @@
+/**
+ * @file        ui/d3d12/d3d12_frame_interpolator.h
+ * @brief       NG2 ADDITION: vendor-neutral frame generation for the D3D12 presenter.
+ *
+ * Generates a frame halfway between the two most recent guest frames using only the
+ * final images (no game motion vectors):
+ *  - a luma pyramid per frame (analysis base ~960 px wide, 5 levels);
+ *  - dense per-pixel optical flow in both directions, coarse to fine: at each level every
+ *    pixel picks the best of a few candidates (upsampled coarser flow, its neighbours,
+ *    zero, last frame's flow; a small full search at the coarsest level) by zero-mean
+ *    patch difference, refines it with Lucas-Kanade iterations, then the field is
+ *    smoothed edge-aware (weighted by luma similarity and match quality);
+ *  - synthesis at full resolution: both frames are warped to the midpoint and blended
+ *    by forward-backward consistency (occlusion), then softly mixed with the zero-motion
+ *    blend (static HUD) and the newer frame (nothing explains the change). Every choice
+ *    is a soft weight, so there are no seams between pixels that chose differently.
+ * Compute shaders are compiled at runtime with d3dcompiler_47.dll (ships with Windows).
+ */
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+
+#include <rex/platform.h>
+#include <rex/ui/d3d12/d3d12_api.h>
+
+namespace rex::ui::d3d12 {
+
+class D3D12Provider;
+class D3D12SubmissionTracker;
+
+class D3D12FrameInterpolator {
+ public:
+  D3D12FrameInterpolator(const D3D12Provider& provider, D3D12SubmissionTracker& paint_tracker);
+  ~D3D12FrameInterpolator();
+
+  // Compiles the shaders and creates the pipelines. False if unavailable.
+  bool Initialize();
+
+  // Copies a new guest frame (in D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE) into the
+  // history and builds its luma pyramid. Records commands on the paint command list.
+  // NG2 ADDITION: frames larger than max_width x max_height (the swap chain) are
+  // area-downscaled to fit first, so generation costs the same at any internal resolution.
+  bool PushFrame(ID3D12GraphicsCommandList* command_list, ID3D12Resource* guest_frame,
+                 uint64_t paint_submission, uint32_t max_width, uint32_t max_height);
+  // Size of current() / interpolated().
+  uint32_t width() const { return width_; }
+  uint32_t height() const { return height_; }
+  // Generates the frame halfway between the previous and the current pushed frames.
+  bool Interpolate(ID3D12GraphicsCommandList* command_list, uint64_t paint_submission);
+
+  bool HasPrevious() const { return frame_count_ >= 2; }
+  // The textures are in PIXEL_SHADER_RESOURCE | NON_PIXEL_SHADER_RESOURCE, the guest
+  // output format, and the guest output size.
+  ID3D12Resource* current() const { return history_[current_].Get(); }
+  ID3D12Resource* interpolated() const { return interpolated_.Get(); }
+
+  // Forget the history (frame generation turned off, or a discontinuity).
+  void Reset() {
+    frame_count_ = 0;
+    prior_valid_ = false;
+  }
+
+  // NG2 DIAG: 0 off, 1 generated left | real right, 2 real left | generated right.
+  void set_debug_split(uint32_t split) { debug_split_ = split; }
+
+ private:
+  static constexpr uint32_t kLevels = 5;
+  enum Pass { kPassLuma, kPassDown, kPassRefine, kPassSmooth, kPassSynth, kPassResample, kPassCount };
+  // Per dispatch: t0..t3, u0, u1 (unused), written into a ring of the shader-visible heap.
+  static constexpr uint32_t kTableSize = 6;
+  static constexpr uint32_t kHeapDescriptors = 32768;
+  static constexpr uint32_t kConstantCount = 16;
+
+  struct Binding {
+    ID3D12Resource* srv[4] = {};
+    ID3D12Resource* uav = nullptr;
+    D3D12_RESOURCE_STATES uav_state = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+  };
+
+  bool EnsureTextures(uint32_t width, uint32_t height);
+  void ReleaseTextures();
+  void Run(ID3D12GraphicsCommandList* command_list, Pass pass, const Binding& binding,
+           uint32_t thread_width, uint32_t thread_height, const uint32_t* constants);
+
+  const D3D12Provider& provider_;
+  D3D12SubmissionTracker& paint_tracker_;
+  bool initialized_ = false;
+
+  Microsoft::WRL::ComPtr<ID3D12RootSignature> root_signature_;
+  std::array<Microsoft::WRL::ComPtr<ID3D12PipelineState>, kPassCount> pipelines_;
+  Microsoft::WRL::ComPtr<ID3D12DescriptorHeap> heap_;
+  uint32_t heap_next_ = 0;
+
+  uint32_t width_ = 0, height_ = 0;
+  std::array<uint32_t, kLevels> level_width_{}, level_height_{};
+  std::array<Microsoft::WRL::ComPtr<ID3D12Resource>, 2> history_;
+  // [frame slot][level] luma.
+  std::array<std::array<Microsoft::WRL::ComPtr<ID3D12Resource>, kLevels>, 2> pyramid_;
+  // [direction: 0 = previous->current, 1 = current->previous][level] flow (xy, cost).
+  std::array<std::array<Microsoft::WRL::ComPtr<ID3D12Resource>, kLevels>, 2> flow_;
+  std::array<Microsoft::WRL::ComPtr<ID3D12Resource>, kLevels> flow_scratch_;
+  Microsoft::WRL::ComPtr<ID3D12Resource> interpolated_;
+  uint64_t last_usage_ = 0;
+
+  uint32_t current_ = 0;
+  uint32_t frame_count_ = 0;
+  bool prior_valid_ = false;  // flow_[*][0] holds the previous pair's flow
+  uint32_t debug_split_ = 0;
+};
+
+}  // namespace rex::ui::d3d12
