+  }
+  SDL_SetWindowPosition(sdl_window_, SDL_WINDOWPOS_CENTERED_DISPLAY(display),
+                        SDL_WINDOWPOS_CENTERED_DISPLAY(display));
+  if (fullscreen) {
+    SDL_SetWindowFullscreen(sdl_window_, true);
