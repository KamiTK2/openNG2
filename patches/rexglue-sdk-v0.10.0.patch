diff --git a/src/kernel/xboxkrnl/ng2_diag_stats.h b/src/kernel/xboxkrnl/ng2_diag_stats.h
new file mode 100644
index 0000000..6880031
--- /dev/null
+++ b/src/kernel/xboxkrnl/ng2_diag_stats.h
@@ -0,0 +1,101 @@
+#pragma once
+// NG2 DIAG: per-second load-time statistics (cvar diag_io_stats): file reads (count, bytes,
+// time), guest sleeps (KeDelayExecutionThread) and blocking waits, with the top threads by
+// time spent asleep / waiting. Used to find what loading screens spend their time on.
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/system/xthread.h>
+
+REXCVAR_DECLARE(bool, diag_io_stats);
+
+namespace rex::kernel::ng2diag {
+
+inline std::atomic<uint64_t> g_reads{0}, g_read_bytes{0}, g_read_us{0};
+inline std::atomic<uint64_t> g_delays{0}, g_delay_us{0}, g_waits{0}, g_wait_us{0};
+inline std::mutex g_thread_mutex;
+inline std::unordered_map<std::string, std::pair<uint64_t, uint64_t>> g_thread_us;  // delay, wait
+inline std::atomic<int64_t> g_last_ms{0};
+
+inline int64_t NowUs() {
+  return std::chrono::duration_cast<std::chrono::microseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+inline void MaybeLog() {
+  const int64_t now_ms = NowUs() / 1000;
+  int64_t last = g_last_ms.load();
+  if (now_ms - last < 1000 || !g_last_ms.compare_exchange_strong(last, now_ms)) return;
+  const uint64_t reads = g_reads.exchange(0), bytes = g_read_bytes.exchange(0),
+                 read_us = g_read_us.exchange(0), delays = g_delays.exchange(0),
+                 delay_us = g_delay_us.exchange(0), waits = g_waits.exchange(0),
+                 wait_us = g_wait_us.exchange(0);
+  std::vector<std::pair<std::string, std::pair<uint64_t, uint64_t>>> threads;
+  {
+    std::lock_guard lock(g_thread_mutex);
+    threads.assign(g_thread_us.begin(), g_thread_us.end());
+    g_thread_us.clear();
+  }
+  if (!reads && !delay_us && !wait_us) return;
+  std::sort(threads.begin(), threads.end(), [](auto& a, auto& b) {
+    return a.second.first + a.second.second > b.second.first + b.second.second;
+  });
+  std::string top;
+  for (size_t i = 0; i < threads.size() && i < 5; ++i) {
+    top += " | " + threads[i].first + " sleep " + std::to_string(threads[i].second.first / 1000) +
+           "ms wait " + std::to_string(threads[i].second.second / 1000) + "ms";
+  }
+  REXLOG_INFO("NG2DIAG io: reads {} ({} KB, {} ms) sleeps {} ({} ms) waits {} ({} ms){}", reads,
+              bytes / 1024, read_us / 1000, delays, delay_us / 1000, waits, wait_us / 1000, top);
+}
+
+inline void AddThread(bool sleep, uint64_t us) {
+  auto* t = rex::system::XThread::GetCurrentThread();
+  std::string name = t ? t->name() : "host";
+  if (name.empty() && t) name = "thread " + std::to_string(t->thread_id());
+  std::lock_guard lock(g_thread_mutex);
+  auto& e = g_thread_us[name];
+  (sleep ? e.first : e.second) += us;
+}
+
+// Times a scope: kind 0 = file read (bytes given at Done), 1 = sleep, 2 = wait.
+struct Timer {
+  int kind;
+  int64_t start;
+  bool on;
+  explicit Timer(int k) : kind(k), start(0), on(REXCVAR_GET(diag_io_stats)) {
+    if (on) start = NowUs();
+  }
+  void Done(uint64_t bytes = 0) {
+    if (!on) return;
+    on = false;
+    const uint64_t us = uint64_t(NowUs() - start);
+    if (kind == 0) {
+      g_reads.fetch_add(1);
+      g_read_bytes.fetch_add(bytes);
+      g_read_us.fetch_add(us);
+    } else if (kind == 1) {
+      g_delays.fetch_add(1);
+      g_delay_us.fetch_add(us);
+      AddThread(true, us);
+    } else {
+      g_waits.fetch_add(1);
+      g_wait_us.fetch_add(us);
+      AddThread(false, us);
+    }
+    MaybeLog();
+  }
+  ~Timer() { Done(); }
+};
+
+}  // namespace rex::kernel::ng2diag
