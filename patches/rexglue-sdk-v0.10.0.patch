+    const RegisterFile& r = *register_file_;
+    const GpuProfSegment& c = gpu_prof_cur_;
+    if (c.draws && (REXCVAR_GET(diag_gpu_passes_per_draw) ||
+                    c.surface_info != r.values[XE_GPU_REG_RB_SURFACE_INFO] ||
+                    c.color_info[0] != r.values[XE_GPU_REG_RB_COLOR_INFO] ||
+                    c.depth_info != r.values[XE_GPU_REG_RB_DEPTH_INFO] ||
+                    c.viewport_w != std::fabs(r.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE)) * 2.0f ||
+                    c.viewport_h != std::fabs(r.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE)) * 2.0f)) {
+      GpuProfMark(false);
+      gpu_prof_segments_.back().resolve = false;
+    }
+  }
+  GpuProfSegment& seg = gpu_prof_cur_;
+  if (!seg.draws++) {
+    const RegisterFile& regs = *register_file_;
+    seg.vs = active_vertex_shader() ? active_vertex_shader()->ucode_data_hash() : 0;
+    seg.ps = active_pixel_shader() ? active_pixel_shader()->ucode_data_hash() : 0;
+    seg.surface_info = regs.values[XE_GPU_REG_RB_SURFACE_INFO];
+    seg.color_info[0] = regs.values[XE_GPU_REG_RB_COLOR_INFO];
+    seg.color_info[1] = regs.values[XE_GPU_REG_RB_COLOR1_INFO];
+    seg.color_info[2] = regs.values[XE_GPU_REG_RB_COLOR2_INFO];
+    seg.color_info[3] = regs.values[XE_GPU_REG_RB_COLOR3_INFO];
+    seg.color_mask = regs.values[XE_GPU_REG_RB_COLOR_MASK];
+    seg.depth_info = regs.values[XE_GPU_REG_RB_DEPTH_INFO];
+    seg.viewport_w = std::fabs(regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE)) * 2.0f;
+    seg.viewport_h = std::fabs(regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE)) * 2.0f;
+  }
+}
+
+void D3D12CommandProcessor::GpuProfMark(bool resolve) {
+  if (!gpu_prof_marks_ || gpu_prof_marks_ >= kGpuProfMaxMarks || !BeginSubmission(true)) return;
+  GpuProfSegment& seg = gpu_prof_cur_;
+  seg.resolve = resolve;
+  if (resolve) {
+    const RegisterFile& regs = *register_file_;
+    seg.copy_dest_base = regs.values[XE_GPU_REG_RB_COPY_DEST_BASE];
+    seg.copy_dest_pitch = regs.values[XE_GPU_REG_RB_COPY_DEST_PITCH];
+    seg.copy_dest_info = regs.values[XE_GPU_REG_RB_COPY_DEST_INFO];
+    seg.copy_control = regs.values[XE_GPU_REG_RB_COPY_CONTROL];
+    if (!seg.draws) {  // a resolve right after another: note the source surface anyway
+      seg.surface_info = regs.values[XE_GPU_REG_RB_SURFACE_INFO];
+      seg.color_info[0] = regs.values[XE_GPU_REG_RB_COLOR_INFO];
+      seg.depth_info = regs.values[XE_GPU_REG_RB_DEPTH_INFO];
+    }
+  }
+  deferred_command_list_.D3DEndQuery(gpu_prof_heap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
+                                     gpu_prof_marks_++);
+  static uint64_t start_batches = 0, start_loads = 0, start_uploads = 0;
+  if (gpu_prof_marks_ > 2) {  // the first segment has no recorded start
+    seg.batches = uint32_t(g_ng2_gpu_work.barrier_batches - start_batches);
+    seg.loads = uint32_t(g_ng2_gpu_work.texture_loads - start_loads);
+    seg.uploads = uint32_t(g_ng2_gpu_work.uploads - start_uploads);
+  }
+  start_batches = g_ng2_gpu_work.barrier_batches;
+  start_loads = g_ng2_gpu_work.texture_loads;
+  start_uploads = g_ng2_gpu_work.uploads;
+  gpu_prof_segments_.push_back(seg);
+  seg = GpuProfSegment();
+}
+
+void D3D12CommandProcessor::GpuProfOnSwap() {
+  GpuProfPoll();
+  if (gpu_prof_active_) {
+    GpuProfMark(false);
+    if (gpu_prof_marks_ > 1) {
+      deferred_command_list_.D3DResolveQueryData(gpu_prof_heap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
+                                                 0, gpu_prof_marks_, gpu_prof_readback_.Get(), 0);
+      gpu_prof_pending_submission_ = submission_current_;
+      gpu_prof_pending_marks_ = gpu_prof_marks_;
+      gpu_prof_pending_segments_ = std::move(gpu_prof_segments_);
+    }
+    gpu_prof_active_ = false;
+    g_ng2_log_frame_work = false;
+  }
+  gpu_prof_segments_.clear();
+  gpu_prof_marks_ = 0;
+  gpu_prof_cur_ = GpuProfSegment();
+  const int32_t every = REXCVAR_GET(diag_gpu_passes);
+  if (every <= 0 || gpu_prof_failed_ || gpu_prof_pending_marks_) return;
+  if (++gpu_prof_frame_ % uint32_t(every)) return;
+  if (!gpu_prof_heap_) {
+    ID3D12Device* device = GetD3D12Provider().GetDevice();
+    D3D12_QUERY_HEAP_DESC heap_desc = {};
+    heap_desc.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+    heap_desc.Count = kGpuProfMaxMarks;
+    D3D12_RESOURCE_DESC buffer_desc;
+    ui::d3d12::util::FillBufferResourceDesc(buffer_desc, kGpuProfMaxMarks * sizeof(uint64_t),
+                                            D3D12_RESOURCE_FLAG_NONE);
+    if (FAILED(device->CreateQueryHeap(&heap_desc, IID_PPV_ARGS(&gpu_prof_heap_))) ||
+        FAILED(device->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesReadback, D3D12_HEAP_FLAG_NONE, &buffer_desc,
+            D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&gpu_prof_readback_)))) {
+      REXGPU_ERROR("NG2 GPU passes: could not create the timestamp resources");
+      gpu_prof_failed_ = true;
+      return;
+    }
+  }
+  gpu_prof_active_ = true;  // the next frame (after this swap) is profiled
+  g_ng2_log_frame_work = REXCVAR_GET(diag_gpu_work);
+}
+
+void D3D12CommandProcessor::GpuProfPoll() {
+  if (!gpu_prof_pending_marks_ || submission_completed_ < gpu_prof_pending_submission_) return;
+  const uint32_t n = gpu_prof_pending_marks_;
+  gpu_prof_pending_marks_ = 0;
+  UINT64 freq = 0;
+  GetD3D12Provider().GetDirectQueue()->GetTimestampFrequency(&freq);
+  void* mapping = nullptr;
+  D3D12_RANGE read_range = {0, n * sizeof(uint64_t)};
+  if (!freq || FAILED(gpu_prof_readback_->Map(0, &read_range, &mapping))) return;
+  std::vector<uint64_t> t(n);
+  std::memcpy(t.data(), mapping, n * sizeof(uint64_t));
+  D3D12_RANGE written_range = {0, 0};
+  gpu_prof_readback_->Unmap(0, &written_range);
+  auto ms = [&](uint64_t a, uint64_t b) { return b > a ? double(b - a) * 1000.0 / double(freq) : 0.0; };
+  uint32_t draws = 0;
+  for (const auto& seg : gpu_prof_pending_segments_) draws += seg.draws;
+  REXGPU_INFO("NG2 GPU passes: frame {:.3f} ms GPU, {} segments, {} draws", ms(t[0], t[n - 1]),
+              n - 1, draws);
+  if (REXCVAR_GET(diag_gpu_passes_per_draw)) {
+    {  // NG2 DIAG: GPU time by what was recorded with the draw
+      double t_load = 0, t_upload = 0, t_batch = 0, t_clean = 0;
+      uint32_t n_load = 0, n_upload = 0, n_batch = 0, n_clean = 0, loads = 0, batches = 0;
+      for (uint32_t i = 1; i < n && i - 1 < gpu_prof_pending_segments_.size(); ++i) {
+        const GpuProfSegment& seg = gpu_prof_pending_segments_[i - 1];
+        const double d = ms(t[i - 1], t[i]);
+        loads += seg.loads;
+        batches += seg.batches;
+        if (seg.loads) {
+          t_load += d, ++n_load;
+        } else if (seg.uploads) {
+          t_upload += d, ++n_upload;
+        } else if (seg.batches) {
+          t_batch += d, ++n_batch;
+        } else {
+          t_clean += d, ++n_clean;
+        }
+      }
+      REXGPU_INFO("NG2 GPU by kind: with texture load {:.3f} ms ({} segs, {} loads) | with upload "
+                  "{:.3f} ms ({}) | other barriers {:.3f} ms ({}) | clean {:.3f} ms ({}, {:.2f} "
+                  "us each) | batches {}",
+                  t_load, n_load, loads, t_upload, n_upload, t_batch, n_batch, t_clean, n_clean,
+                  n_clean ? t_clean * 1000.0 / n_clean : 0.0, batches);
+    }
+    // Totals per shader pair (+ target size), most expensive first.
+    struct Total { double ms = 0; uint32_t draws = 0; uint32_t pitch = 0; float vw = 0, vh = 0; };
+    std::unordered_map<std::string, Total> totals;
+    for (uint32_t i = 1; i < n && i - 1 < gpu_prof_pending_segments_.size(); ++i) {
+      const GpuProfSegment& seg = gpu_prof_pending_segments_[i - 1];
+      if (!seg.draws) continue;
+      Total& tot = totals[fmt::format("vs {:016X} ps {:016X}", seg.vs, seg.ps)];
+      tot.ms += ms(t[i - 1], t[i]);
+      tot.draws += seg.draws;
+      tot.pitch = seg.surface_info & 0x3FFF;
+      tot.vw = seg.viewport_w;
