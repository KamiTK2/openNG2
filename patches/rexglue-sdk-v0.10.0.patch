+// NG2 ADDITION: frame generation - a port of ui/d3d12/d3d12_frame_interpolator (see its
+// header for the method). Same HLSL, compiled to SPIR-V offline by
+// tools/gen_framegen_spirv.py. Internal images (luma pyramid, flow) stay in GENERAL; the
+// history frames and the generated frame are guest output images, left in
+// SHADER_READ_ONLY_OPTIMAL for the presenter between passes.
+class VulkanPresenter::FrameInterpolator {
+ public:
+  FrameInterpolator(const VulkanDevice* vulkan_device, VulkanSubmissionTracker& paint_tracker)
+      : vulkan_device_(vulkan_device), paint_tracker_(paint_tracker) {}
+  ~FrameInterpolator();
+  bool Initialize();
+  bool PushFrame(VkCommandBuffer command_buffer, const GuestOutputImage& guest_frame,
+                 uint64_t paint_submission, uint32_t max_width, uint32_t max_height);
+  bool Interpolate(VkCommandBuffer command_buffer, uint64_t paint_submission);
+  bool HasPrevious() const { return frame_count_ >= 2; }
+  uint32_t width() const { return width_; }
+  uint32_t height() const { return height_; }
+  const std::shared_ptr<GuestOutputImage>& current() const { return history_[current_]; }
+  const std::shared_ptr<GuestOutputImage>& interpolated() const { return interpolated_; }
+  void Reset() {
+    frame_count_ = 0;
+    prior_valid_ = false;
+  }
+  void set_debug_split(uint32_t split) { debug_split_ = split; }
+
+ private:
+  static constexpr uint32_t kLevels = 5;
+  enum Pass { kPassLuma, kPassDown, kPassRefine, kPassSmooth, kPassSynth, kPassResample, kPassCount };
+  static constexpr uint32_t kConstantCount = 16;
+  static constexpr uint32_t kPools = 4;
+  static constexpr uint32_t kSetsPerPool = 64;
+  static constexpr uint32_t kAnalysisWidth = 960;
+  static constexpr uint32_t kCoarseSearchRadius = 4;
+  static constexpr VkFormat kLumaFormat = VK_FORMAT_R16_SFLOAT;
+  static constexpr VkFormat kFlowFormat = VK_FORMAT_R32G32B32A32_SFLOAT;
+
+  struct Image {
+    VkImage image = VK_NULL_HANDLE;
+    VkDeviceMemory memory = VK_NULL_HANDLE;
+    VkImageView view = VK_NULL_HANDLE;
+  };
+  struct Source {
+    VkImage image = VK_NULL_HANDLE;
+    VkImageView view = VK_NULL_HANDLE;
+  };
+
+  static uint32_t DivUp(uint32_t a, uint32_t b) { return (a + b - 1) / b; }
+  static uint32_t AsUint(float f) {
+    uint32_t u;
+    std::memcpy(&u, &f, sizeof(u));
+    return u;
+  }
+  bool CreateImage(uint32_t width, uint32_t height, VkFormat format, Image& out);
+  void DestroyImage(Image& image);
+  bool EnsureTextures(uint32_t width, uint32_t height);
+  void ReleaseTextures();
+  VkImageLayout& LayoutOf(VkImage image);
+  void Transition(VkCommandBuffer command_buffer, VkImage image, VkImageLayout layout);
+  void Run(VkCommandBuffer command_buffer, Pass pass, const Source* sources, Source dest,
+           uint32_t thread_width, uint32_t thread_height, const uint32_t* constants);
+
+  const VulkanDevice* vulkan_device_;
+  VulkanSubmissionTracker& paint_tracker_;
+  bool initialized_ = false;
+  VkSampler samplers_[2] = {};
+  VkDescriptorSetLayout set_layout_ = VK_NULL_HANDLE;
+  VkPipelineLayout pipeline_layout_ = VK_NULL_HANDLE;
+  VkPipeline pipelines_[kPassCount] = {};
+  VkDescriptorPool pools_[kPools] = {};
+  uint64_t pool_submission_[kPools] = {};
+  uint64_t submission_ = 0;
+  bool pool_exhausted_logged_ = false;
+  Image dummy_;
+
+  uint32_t width_ = 0, height_ = 0;
+  std::array<uint32_t, kLevels> level_width_{}, level_height_{};
+  std::array<std::shared_ptr<GuestOutputImage>, 2> history_;
+  std::array<std::array<Image, kLevels>, 2> pyramid_;
+  std::array<std::array<Image, kLevels>, 2> flow_;
+  std::array<Image, kLevels> flow_scratch_;
+  std::shared_ptr<GuestOutputImage> interpolated_;
+  std::vector<std::pair<VkImage, VkImageLayout>> layouts_;
+  uint64_t last_usage_ = 0;
+  uint32_t current_ = 0;
+  uint32_t frame_count_ = 0;
+  bool prior_valid_ = false;
+  uint32_t debug_split_ = 0;
+};
+
+VulkanPresenter::FrameInterpolator::~FrameInterpolator() {
+  ReleaseTextures();
+  const VulkanDevice::Functions& dfn = vulkan_device_->functions();
+  const VkDevice device = vulkan_device_->device();
+  DestroyImage(dummy_);
+  for (VkDescriptorPool& pool : pools_) {
+    util::DestroyAndNullHandle(dfn.vkDestroyDescriptorPool, device, pool);
+  }
+  for (VkPipeline& pipeline : pipelines_) {
+    util::DestroyAndNullHandle(dfn.vkDestroyPipeline, device, pipeline);
+  }
+  util::DestroyAndNullHandle(dfn.vkDestroyPipelineLayout, device, pipeline_layout_);
+  util::DestroyAndNullHandle(dfn.vkDestroyDescriptorSetLayout, device, set_layout_);
+  for (VkSampler& sampler : samplers_) {
+    util::DestroyAndNullHandle(dfn.vkDestroySampler, device, sampler);
+  }
+}
+
+bool VulkanPresenter::FrameInterpolator::Initialize() {
+  if (initialized_) return true;
+  const VulkanDevice::Functions& dfn = vulkan_device_->functions();
+  const VkDevice device = vulkan_device_->device();
+  if (!vulkan_device_->properties().shaderStorageImageExtendedFormats) {
+    REXLOG_ERROR("Frame generation: shaderStorageImageExtendedFormats is not supported");
+    return false;
+  }
+  VkFormatProperties format_properties;
+  vulkan_device_->vulkan_instance()->functions().vkGetPhysicalDeviceFormatProperties(
+      vulkan_device_->physical_device(), kGuestOutputFormat, &format_properties);
+  if (!(format_properties.optimalTilingFeatures & VK_FORMAT_FEATURE_STORAGE_IMAGE_BIT)) {
+    REXLOG_ERROR("Frame generation: the guest output format can't be a storage image");
+    return false;
+  }
+  for (uint32_t i = 0; i < 2; ++i) {
+    VkSamplerCreateInfo sampler_info = {};
+    sampler_info.sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO;
+    sampler_info.magFilter = sampler_info.minFilter = i ? VK_FILTER_NEAREST : VK_FILTER_LINEAR;
+    sampler_info.mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST;
+    sampler_info.addressModeU = sampler_info.addressModeV = sampler_info.addressModeW =
+        VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+    sampler_info.maxLod = VK_LOD_CLAMP_NONE;
+    if (dfn.vkCreateSampler(device, &sampler_info, nullptr, &samplers_[i]) != VK_SUCCESS) {
+      return false;
+    }
+  }
+  VkDescriptorSetLayoutBinding bindings[7] = {};
+  for (uint32_t i = 0; i < 7; ++i) {
+    bindings[i].binding = i;
+    bindings[i].descriptorCount = 1;
+    bindings[i].stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+    bindings[i].descriptorType = i < 4    ? VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE
+                                 : i == 4 ? VK_DESCRIPTOR_TYPE_STORAGE_IMAGE
+                                          : VK_DESCRIPTOR_TYPE_SAMPLER;
+    if (i >= 5) bindings[i].pImmutableSamplers = &samplers_[i - 5];
+  }
+  VkDescriptorSetLayoutCreateInfo set_layout_info = {};
+  set_layout_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO;
+  set_layout_info.bindingCount = 7;
+  set_layout_info.pBindings = bindings;
+  if (dfn.vkCreateDescriptorSetLayout(device, &set_layout_info, nullptr, &set_layout_) !=
+      VK_SUCCESS) {
+    return false;
+  }
+  VkPushConstantRange push_range = {VK_SHADER_STAGE_COMPUTE_BIT, 0,
+                                    sizeof(uint32_t) * kConstantCount};
+  VkPipelineLayoutCreateInfo pipeline_layout_info = {};
+  pipeline_layout_info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+  pipeline_layout_info.setLayoutCount = 1;
+  pipeline_layout_info.pSetLayouts = &set_layout_;
+  pipeline_layout_info.pushConstantRangeCount = 1;
+  pipeline_layout_info.pPushConstantRanges = &push_range;
+  if (dfn.vkCreatePipelineLayout(device, &pipeline_layout_info, nullptr, &pipeline_layout_) !=
+      VK_SUCCESS) {
+    return false;
+  }
+  namespace spirv = ng2_frame_interpolator_spirv;
+  struct Code {
+    const uint32_t* words;
+    size_t size;
+    const char* entry;
+  };
+  const Code codes[kPassCount] = {
+      {spirv::kCSLuma, sizeof(spirv::kCSLuma), "CSLuma"},
+      {spirv::kCSDown, sizeof(spirv::kCSDown), "CSDown"},
+      {spirv::kCSRefine, sizeof(spirv::kCSRefine), "CSRefine"},
+      {spirv::kCSSmooth, sizeof(spirv::kCSSmooth), "CSSmooth"},
+      {spirv::kCSSynth, sizeof(spirv::kCSSynth), "CSSynth"},
+      {spirv::kCSResample, sizeof(spirv::kCSResample), "CSResample"},
+  };
+  for (uint32_t i = 0; i < kPassCount; ++i) {
+    pipelines_[i] = util::CreateComputePipeline(vulkan_device_, pipeline_layout_, codes[i].words,
+                                                codes[i].size, nullptr, codes[i].entry);
+    if (pipelines_[i] == VK_NULL_HANDLE) {
+      REXLOG_ERROR("Frame generation: failed to create the {} pipeline", codes[i].entry);
+      return false;
+    }
+  }
+  VkDescriptorPoolSize pool_sizes[2] = {
+      {VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, kSetsPerPool * 4},
+      {VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, kSetsPerPool},
+  };
+  VkDescriptorPoolCreateInfo pool_info = {};
+  pool_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
+  pool_info.maxSets = kSetsPerPool;
+  pool_info.poolSizeCount = 2;
+  pool_info.pPoolSizes = pool_sizes;
+  for (VkDescriptorPool& pool : pools_) {
+    if (dfn.vkCreateDescriptorPool(device, &pool_info, nullptr, &pool) != VK_SUCCESS) {
+      return false;
+    }
+  }
+  if (!CreateImage(1, 1, kLumaFormat, dummy_)) {
+    return false;
+  }
+  initialized_ = true;
+  REXLOG_INFO("Frame generation: initialized (Vulkan, dense optical flow)");
+  return true;
+}
+
+bool VulkanPresenter::FrameInterpolator::CreateImage(uint32_t width, uint32_t height,
+                                                     VkFormat format, Image& out) {
+  VkImageCreateInfo image_info = {};
+  image_info.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+  image_info.imageType = VK_IMAGE_TYPE_2D;
+  image_info.format = format;
+  image_info.extent = {std::max(width, 1u), std::max(height, 1u), 1};
+  image_info.mipLevels = 1;
+  image_info.arrayLayers = 1;
+  image_info.samples = VK_SAMPLE_COUNT_1_BIT;
+  image_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+  image_info.usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT;
+  image_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+  image_info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+  if (!util::CreateDedicatedAllocationImage(vulkan_device_, image_info,
+                                            util::MemoryPurpose::kDeviceLocal, out.image,
+                                            out.memory)) {
+    return false;
+  }
+  VkImageViewCreateInfo view_info = {};
+  view_info.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
+  view_info.image = out.image;
+  view_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+  view_info.format = format;
+  view_info.subresourceRange = util::InitializeSubresourceRange();
+  if (vulkan_device_->functions().vkCreateImageView(vulkan_device_->device(), &view_info, nullptr,
+                                                    &out.view) != VK_SUCCESS) {
+    DestroyImage(out);
+    return false;
+  }
+  return true;
+}
+
+void VulkanPresenter::FrameInterpolator::DestroyImage(Image& image) {
+  const VulkanDevice::Functions& dfn = vulkan_device_->functions();
+  const VkDevice device = vulkan_device_->device();
+  for (size_t i = 0; i < layouts_.size(); ++i) {
+    if (layouts_[i].first == image.image) {
+      layouts_.erase(layouts_.begin() + i);
+      break;
+    }
+  }
+  util::DestroyAndNullHandle(dfn.vkDestroyImageView, device, image.view);
+  util::DestroyAndNullHandle(dfn.vkDestroyImage, device, image.image);
+  util::DestroyAndNullHandle(dfn.vkFreeMemory, device, image.memory);
+}
+
+void VulkanPresenter::FrameInterpolator::ReleaseTextures() {
+  if (width_) paint_tracker_.AwaitSubmissionCompletion(last_usage_);
+  for (auto& image : history_) {
+    if (image) {
+      for (size_t i = 0; i < layouts_.size(); ++i) {
+        if (layouts_[i].first == image->image()) {
+          layouts_.erase(layouts_.begin() + i);
+          break;
+        }
+      }
+    }
+    image.reset();
+  }
+  if (interpolated_) {
+    for (size_t i = 0; i < layouts_.size(); ++i) {
+      if (layouts_[i].first == interpolated_->image()) {
+        layouts_.erase(layouts_.begin() + i);
+        break;
+      }
+    }
+  }
+  interpolated_.reset();
+  for (auto& slot : pyramid_) {
+    for (Image& image : slot) DestroyImage(image);
+  }
+  for (auto& dir : flow_) {
+    for (Image& image : dir) DestroyImage(image);
+  }
+  for (Image& image : flow_scratch_) DestroyImage(image);
+  width_ = height_ = 0;
+  frame_count_ = 0;
+  prior_valid_ = false;
+}
+
+bool VulkanPresenter::FrameInterpolator::EnsureTextures(uint32_t width, uint32_t height) {
+  if (width == width_ && height == height_) return true;
+  ReleaseTextures();
+  width_ = width;
+  height_ = height;
+  const uint32_t factor =
+      std::max(1u, uint32_t(std::lround(double(width) / double(kAnalysisWidth))));
+  level_width_[0] = DivUp(width, factor);
+  level_height_[0] = DivUp(height, factor);
+  for (uint32_t l = 1; l < kLevels; ++l) {
+    level_width_[l] = DivUp(level_width_[l - 1], 2);
+    level_height_[l] = DivUp(level_height_[l - 1], 2);
+  }
+  bool ok = true;
+  for (uint32_t i = 0; i < 2; ++i) {
+    history_[i] = GuestOutputImage::Create(vulkan_device_, width, height);
+    ok &= bool(history_[i]);
+  }
+  interpolated_ = GuestOutputImage::Create(vulkan_device_, width, height);
+  ok &= bool(interpolated_);
+  for (uint32_t l = 0; l < kLevels && ok; ++l) {
+    for (uint32_t i = 0; i < 2; ++i) {
+      ok &= CreateImage(level_width_[l], level_height_[l], kLumaFormat, pyramid_[i][l]);
+      ok &= CreateImage(level_width_[l], level_height_[l], kFlowFormat, flow_[i][l]);
+    }
+    ok &= CreateImage(level_width_[l], level_height_[l], kFlowFormat, flow_scratch_[l]);
+  }
+  if (!ok) {
+    REXLOG_ERROR("Frame generation: failed to create {}x{} images", width, height);
+    ReleaseTextures();
+    return false;
+  }
+  REXLOG_INFO("Frame generation: {}x{} (flow {}x{} .. {}x{})", width, height, level_width_[0],
+              level_height_[0], level_width_[kLevels - 1], level_height_[kLevels - 1]);
+  return true;
+}
+
+VkImageLayout& VulkanPresenter::FrameInterpolator::LayoutOf(VkImage image) {
+  for (auto& entry : layouts_) {
+    if (entry.first == image) return entry.second;
+  }
+  layouts_.emplace_back(image, VK_IMAGE_LAYOUT_UNDEFINED);
+  return layouts_.back().second;
+}
+
+void VulkanPresenter::FrameInterpolator::Transition(VkCommandBuffer command_buffer, VkImage image,
+                                                    VkImageLayout layout) {
+  VkImageLayout& current = LayoutOf(image);
+  if (current == layout) return;
+  VkImageMemoryBarrier barrier = {};
+  barrier.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+  barrier.srcAccessMask = current == VK_IMAGE_LAYOUT_UNDEFINED
+                              ? 0
+                              : (VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT);
+  barrier.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+  barrier.oldLayout = current;
+  barrier.newLayout = layout;
+  barrier.srcQueueFamilyIndex = barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+  barrier.image = image;
+  barrier.subresourceRange = util::InitializeSubresourceRange();
+  vulkan_device_->functions().vkCmdPipelineBarrier(
+      command_buffer,
+      VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT,
+      VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, 0, 0, nullptr,
+      0, nullptr, 1, &barrier);
+  current = layout;
+}
+
+void VulkanPresenter::FrameInterpolator::Run(VkCommandBuffer command_buffer, Pass pass,
+                                             const Source* sources, Source dest,
+                                             uint32_t thread_width, uint32_t thread_height,
+                                             const uint32_t* constants) {
+  const VulkanDevice::Functions& dfn = vulkan_device_->functions();
+  const VkDevice device = vulkan_device_->device();
+  // A descriptor pool per paint submission (ring), reset once that submission is done.
+  uint32_t pool_index = uint32_t(submission_ % kPools);
+  if (pool_submission_[pool_index] != submission_) {
+    paint_tracker_.AwaitSubmissionCompletion(pool_submission_[pool_index]);
+    dfn.vkResetDescriptorPool(device, pools_[pool_index], 0);
+    pool_submission_[pool_index] = submission_;
+  }
+  VkDescriptorSetAllocateInfo allocate_info = {};
+  allocate_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+  allocate_info.descriptorPool = pools_[pool_index];
+  allocate_info.descriptorSetCount = 1;
+  allocate_info.pSetLayouts = &set_layout_;
+  VkDescriptorSet set;
+  if (dfn.vkAllocateDescriptorSets(device, &allocate_info, &set) != VK_SUCCESS) {
+    if (!pool_exhausted_logged_) {
+      pool_exhausted_logged_ = true;
+      REXLOG_ERROR("Frame generation: out of descriptor sets");
+    }
+    return;
+  }
+  Transition(command_buffer, dest.image, VK_IMAGE_LAYOUT_GENERAL);
+  VkDescriptorImageInfo infos[5] = {};
+  VkWriteDescriptorSet writes[5] = {};
+  for (uint32_t i = 0; i < 5; ++i) {
+    Source source = i < 4 ? sources[i] : dest;
+    if (!source.view) source = {dummy_.image, dummy_.view};
+    VkImageLayout& layout = LayoutOf(source.image);
+    if (layout == VK_IMAGE_LAYOUT_UNDEFINED) Transition(command_buffer, source.image,
+                                                        VK_IMAGE_LAYOUT_GENERAL);
+    infos[i].imageView = source.view;
+    infos[i].imageLayout = i < 4 ? LayoutOf(source.image) : VK_IMAGE_LAYOUT_GENERAL;
+    writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    writes[i].dstSet = set;
+    writes[i].dstBinding = i;
+    writes[i].descriptorCount = 1;
+    writes[i].descriptorType =
+        i < 4 ? VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE : VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+    writes[i].pImageInfo = &infos[i];
+  }
+  dfn.vkUpdateDescriptorSets(device, 5, writes, 0, nullptr);
+  dfn.vkCmdBindPipeline(command_buffer, VK_PIPELINE_BIND_POINT_COMPUTE, pipelines_[pass]);
+  dfn.vkCmdBindDescriptorSets(command_buffer, VK_PIPELINE_BIND_POINT_COMPUTE, pipeline_layout_, 0,
+                              1, &set, 0, nullptr);
+  dfn.vkCmdPushConstants(command_buffer, pipeline_layout_, VK_SHADER_STAGE_COMPUTE_BIT, 0,
+                         sizeof(uint32_t) * kConstantCount, constants);
+  dfn.vkCmdDispatch(command_buffer, DivUp(thread_width, 8), DivUp(thread_height, 8), 1);
+  // The next pass reads what this one wrote.
+  VkMemoryBarrier barrier = {};
+  barrier.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
+  barrier.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+  barrier.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+  dfn.vkCmdPipelineBarrier(command_buffer, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                           VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1, &barrier, 0, nullptr, 0,
+                           nullptr);
+}
+
+bool VulkanPresenter::FrameInterpolator::PushFrame(VkCommandBuffer command_buffer,
+                                                   const GuestOutputImage& guest_frame,
+                                                   uint64_t paint_submission, uint32_t max_width,
+                                                   uint32_t max_height) {
+  if (!initialized_) return false;
+  const uint32_t guest_width = guest_frame.extent().width;
+  const uint32_t guest_height = guest_frame.extent().height;
+  uint32_t width = guest_width, height = guest_height;
+  if (max_width && max_height && (guest_width > max_width || guest_height > max_height)) {
+    const double scale =
+        std::min(double(max_width) / guest_width, double(max_height) / guest_height);
+    width = std::max(1u, uint32_t(std::lround(guest_width * scale)));
+    height = std::max(1u, uint32_t(std::lround(guest_height * scale)));
+  }
+  if (!EnsureTextures(width, height)) return false;
+  last_usage_ = paint_submission;
+  submission_ = paint_submission;
+
+  // The guest frame was written by the guest output refresher; make it visible to compute.
+  VkMemoryBarrier barrier = {};
+  barrier.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
+  barrier.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT;
+  barrier.dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+  vulkan_device_->functions().vkCmdPipelineBarrier(
+      command_buffer, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0,
+      1, &barrier, 0, nullptr, 0, nullptr);
+
+  const uint32_t n = frame_count_ ? (current_ ^ 1) : current_;
+  uint32_t c[kConstantCount] = {};
+  // Copy (or area-downscale) the guest frame into the history.
+  Source sources[4] = {};
+  sources[0] = {guest_frame.image(), guest_frame.view()};
+  LayoutOf(guest_frame.image()) = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+  c[0] = width;
+  c[1] = height;
+  c[2] = guest_width;
+  c[3] = guest_height;
+  Run(command_buffer, kPassResample, sources, {history_[n]->image(), history_[n]->view()}, width,
+      height, c);
+  // The guest output image is not ours - forget its layout.
+  for (size_t i = 0; i < layouts_.size(); ++i) {
+    if (layouts_[i].first == guest_frame.image()) {
+      layouts_.erase(layouts_.begin() + i);
+      break;
+    }
+  }
+  Transition(command_buffer, history_[n]->image(), VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+
+  sources[0] = {history_[n]->image(), history_[n]->view()};
+  c[0] = level_width_[0];
+  c[1] = level_height_[0];
+  c[2] = width_;
+  c[3] = height_;
+  Run(command_buffer, kPassLuma, sources, {pyramid_[n][0].image, pyramid_[n][0].view},
+      level_width_[0], level_height_[0], c);
+  for (uint32_t l = 1; l < kLevels; ++l) {
+    sources[0] = {pyramid_[n][l - 1].image, pyramid_[n][l - 1].view};
+    c[0] = level_width_[l];
+    c[1] = level_height_[l];
+    c[2] = level_width_[l - 1];
+    c[3] = level_height_[l - 1];
+    Run(command_buffer, kPassDown, sources, {pyramid_[n][l].image, pyramid_[n][l].view},
+        level_width_[l], level_height_[l], c);
+  }
+  current_ = n;
+  frame_count_ = std::min(frame_count_ + 1, 2u);
+  return true;
+}
+
+bool VulkanPresenter::FrameInterpolator::Interpolate(VkCommandBuffer command_buffer,
+                                                     uint64_t paint_submission) {
+  if (!initialized_ || !HasPrevious()) return false;
+  last_usage_ = paint_submission;
+  submission_ = paint_submission;
+  const uint32_t cur = current_, prev = current_ ^ 1;
+  // Flow in both directions, coarse to fine: 0 = previous->current, 1 = current->previous.
+  for (uint32_t dir = 0; dir < 2; ++dir) {
+    const uint32_t a = dir ? cur : prev, b = dir ? prev : cur;
+    for (int l = int(kLevels) - 1; l >= 0; --l) {
+      const bool coarsest = l == int(kLevels) - 1;
+      uint32_t c[kConstantCount] = {};
+      c[0] = level_width_[l];
+      c[1] = level_height_[l];
+      Source sources[4] = {};
+      sources[0] = {pyramid_[a][l].image, pyramid_[a][l].view};
+      sources[1] = {pyramid_[b][l].image, pyramid_[b][l].view};
+      if (!coarsest) {
+        sources[2] = {flow_[dir][l + 1].image, flow_[dir][l + 1].view};
+        c[4] = level_width_[l + 1];
+        c[5] = level_height_[l + 1];
+        c[6] = 1;
+        c[10] = AsUint(float(level_width_[l]) / float(level_width_[l + 1]));
+        c[11] = AsUint(float(level_height_[l]) / float(level_height_[l + 1]));
+      }
+      if (prior_valid_) {
+        sources[3] = {flow_[dir][0].image, flow_[dir][0].view};  // previous pair's flow
+        c[7] = 1;
+        c[8] = AsUint(float(level_width_[l]) / float(level_width_[0]));
+        c[9] = AsUint(float(level_height_[l]) / float(level_height_[0]));
+      }
+      c[13] = coarsest ? kCoarseSearchRadius : 0;
+      Run(command_buffer, kPassRefine, sources, {flow_scratch_[l].image, flow_scratch_[l].view},
+          level_width_[l], level_height_[l], c);
+      Source smooth[4] = {};
+      smooth[0] = {pyramid_[a][l].image, pyramid_[a][l].view};
+      smooth[1] = {flow_scratch_[l].image, flow_scratch_[l].view};
+      Run(command_buffer, kPassSmooth, smooth, {flow_[dir][l].image, flow_[dir][l].view},
+          level_width_[l], level_height_[l], c);
+    }
+  }
+  uint32_t c[kConstantCount] = {};
+  c[0] = width_;
+  c[1] = height_;
+  c[4] = level_width_[0];
+  c[5] = level_height_[0];
+  c[8] = AsUint(float(width_) / float(level_width_[0]));
+  c[9] = AsUint(float(height_) / float(level_height_[0]));
+  c[12] = debug_split_;
+  Source sources[4] = {};
+  sources[0] = {history_[prev]->image(), history_[prev]->view()};
+  sources[1] = {history_[cur]->image(), history_[cur]->view()};
+  sources[2] = {flow_[0][0].image, flow_[0][0].view};
+  sources[3] = {flow_[1][0].image, flow_[1][0].view};
+  Run(command_buffer, kPassSynth, sources, {interpolated_->image(), interpolated_->view()}, width_,
+      height_, c);
+  Transition(command_buffer, interpolated_->image(), VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  prior_valid_ = true;
+  return true;
+}
