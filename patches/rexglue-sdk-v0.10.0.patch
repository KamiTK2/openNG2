+// ---- NG2 DIAG: per-pass GPU timing (diag_gpu_passes) ------------------------------------
+void D3D12CommandProcessor::GpuProfOnDraw() {
+  if (!gpu_prof_marks_) {
+    if (!BeginSubmission(true)) return;
+    deferred_command_list_.D3DEndQuery(gpu_prof_heap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP, 0);
+    gpu_prof_marks_ = 1;
+  }
+  {
