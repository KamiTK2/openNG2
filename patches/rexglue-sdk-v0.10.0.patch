+  hot_pages_[0].clear();
+  std::vector<std::pair<uint32_t, uint32_t>> pages;
+  for (size_t i = 1; i <= kHotFrames; ++i) {
+    pages.insert(pages.end(), hot_pages_[i].begin(), hot_pages_[i].end());
+  }
+  std::sort(pages.begin(), pages.end());
+  hot_merged_.clear();
+  for (const auto& r : pages) {
+    if (!hot_merged_.empty() && r.first <= hot_merged_.back().first + hot_merged_.back().second) {
+      auto& last = hot_merged_.back();
+      last.second = std::max(last.first + last.second, r.first + r.second) - last.first;
+    } else {
+      hot_merged_.push_back(r);
+    }
+  }
+  for (auto& r : hot_merged_) {  // pages -> bytes for collect_invalid
+    r.first <<= page_size_log2_;
+    r.second <<= page_size_log2_;
