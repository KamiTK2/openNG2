+// ---- NG2 DIAG: command processor CPU profile (diag_cpu_prof) -----------------------------
+namespace ng2prof {
+State g;
+void OnSwap() {
+  SetLastFrameDrawCount(g.frame_draws);  // NG2 ADDITION (rex/graphics/frame_stats.h)
+  g.frame_draws = 0;
+  static uint64_t frames = 0, t0 = 0;
+  static std::chrono::steady_clock::time_point c0;
+  const int32_t every = REXCVAR_GET(diag_cpu_prof);
+  const bool want = every > 0;
+  if (want != g.enabled) {
+    g = State();
+    g.enabled = want;
+    frames = 0;
+    t0 = Now();
+    c0 = std::chrono::steady_clock::now();
+    return;
+  }
+  if (!want || ++frames < uint64_t(every)) return;
+  const uint64_t t1 = Now();
+  const auto c1 = std::chrono::steady_clock::now();
+  const double ns = double(std::chrono::duration_cast<std::chrono::nanoseconds>(c1 - c0).count());
+  const double ticks = double(t1 - t0);
+  if (ticks <= 0.0 || ns <= 0.0) return;
+  const double ms_per_tick = ns / ticks / 1e6;
+  const double f = double(frames);
+  auto ms = [&](uint64_t v) { return double(v) * ms_per_tick / f; };
+  const double wall = ticks * ms_per_tick / f;
+  double draw_total = 0.0, attributed = 0.0;
+  for (uint32_t p = 0; p < kCount; ++p) {
+    attributed += ms(g.acc[p]);
+    if (p <= kDrawOther) draw_total += ms(g.acc[p]);
+  }
+  const double waiting = ms(g.acc[kIdle]) + ms(g.acc[kWaitRegMem]) + ms(g.acc[kFenceWait]);
+  REXGPU_INFO(
+      "NG2 CP prof ({} frames): frame {:.3f} ms | busy {:.3f} | idle {:.3f} wait_reg_mem {:.3f} "
+      "fence_wait {:.3f} | draws {:.0f}/frame {:.3f} ms ({:.2f} us/draw) | copies {:.1f} | "
+      "packets+other {:.3f}",
+      frames, wall, wall - waiting, ms(g.acc[kIdle]), ms(g.acc[kWaitRegMem]),
+      ms(g.acc[kFenceWait]), double(g.draws) / f, draw_total,
+      g.draws ? draw_total * f * 1000.0 / double(g.draws) : 0.0, double(g.copies) / f,
+      wall - attributed);
+  std::string line;
+  for (uint32_t p = 0; p < kCount; ++p) {
+    if (p == kIdle || p == kWaitRegMem || p == kFenceWait) continue;
+    line += fmt::format(" {} {:.3f}", PhaseName(p), ms(g.acc[p]));
+  }
+  REXGPU_INFO("NG2 CP prof phases (ms/frame):{}", line);
+  const bool enabled = g.enabled;
+  g = State();
+  g.enabled = enabled;
+  frames = 0;
+  t0 = t1;
+  c0 = c1;
+}
+}  // namespace ng2prof
