+
+VulkanTextureCache::Ng2NativeResolve* VulkanTextureCache::Ng2AcquireNativeResolve(
+    uint32_t dest_base, VkFormat host_format, VkFormat image_format, uint32_t width_scaled,
+    uint32_t height_scaled) {
+  // A destination can be resolved at several sizes or formats (NG2 resolves 1CE10000 twice per
+  // frame at two sizes), so keep one snapshot per (destination, format, size) instead of
+  // recreating a full-resolution image on every resolve, which stalled frames. Images that
+  // aren't reused are retired least-recently-acquired first.
+  Ng2NativeResolve* match = nullptr;
+  size_t same_base_count = 0, oldest_same_base = SIZE_MAX, oldest_invalid = SIZE_MAX;
+  for (size_t i = 0; i < ng2_native_resolves_.size(); ++i) {
+    Ng2NativeResolve& entry = ng2_native_resolves_[i];
+    if (entry.dest_base != dest_base) {
+      if (!entry.valid && (oldest_invalid == SIZE_MAX ||
+                           entry.last_acquired < ng2_native_resolves_[oldest_invalid].last_acquired)) {
+        oldest_invalid = i;
+      }
+      continue;
+    }
+    // The destination is being overwritten: every snapshot of it is stale now.
+    entry.valid = false;
+    if (entry.host_format == host_format && entry.image_format == image_format &&
+        entry.width_scaled == width_scaled && entry.height_scaled == height_scaled) {
+      match = &entry;
+      continue;
+    }
+    ++same_base_count;
+    if (oldest_same_base == SIZE_MAX ||
+        entry.last_acquired < ng2_native_resolves_[oldest_same_base].last_acquired) {
+      oldest_same_base = i;
+    }
+  }
+  if (match) {
+    match->last_acquired = ++ng2_native_resolve_acquire_counter_;
+    return match;
+  }
+  size_t retire = SIZE_MAX;
+  if (same_base_count >= 4) {
+    retire = oldest_same_base;
+  } else if (ng2_native_resolves_.size() >= 64) {
+    retire = oldest_invalid;
+    if (retire == SIZE_MAX) {
+      return nullptr;
+    }
+  }
+  if (retire != SIZE_MAX) {
+    // Retire the old image after the GPU is done with it.
+    Ng2NativeResolve& old_entry = ng2_native_resolves_[retire];
+    ng2_native_resolves_destroy_.push_back({command_processor_.GetCurrentSubmission(),
+                                            old_entry.image, old_entry.allocation,
+                                            old_entry.storage_view});
+    ng2_native_resolves_.erase(ng2_native_resolves_.begin() + retire);
+  }
+  VkImageCreateInfo image_create_info = {};
+  image_create_info.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+  image_create_info.imageType = VK_IMAGE_TYPE_2D;
+  image_create_info.format = image_format;
+  image_create_info.extent.width = width_scaled;
+  image_create_info.extent.height = height_scaled;
+  image_create_info.extent.depth = 1;
+  image_create_info.mipLevels = 1;
+  image_create_info.arrayLayers = 1;
+  image_create_info.samples = VK_SAMPLE_COUNT_1_BIT;
+  image_create_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+  image_create_info.usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+  if (image_format == VK_FORMAT_R16G16B16A16_SFLOAT) {
+    // Written by the 4x MSAA -> 1x unpack compute shader in the render target cache.
+    image_create_info.usage |= VK_IMAGE_USAGE_STORAGE_BIT;
+  }
+  image_create_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+  image_create_info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+  VmaAllocationCreateInfo allocation_create_info = {};
+  allocation_create_info.usage = VMA_MEMORY_USAGE_AUTO_PREFER_DEVICE;
+  Ng2NativeResolve entry;
+  if (vmaCreateImage(vma_allocator_, &image_create_info, &allocation_create_info, &entry.image,
+                     &entry.allocation, nullptr) != VK_SUCCESS) {
+    return nullptr;
+  }
+  entry.dest_base = dest_base;
+  entry.host_format = host_format;
+  entry.image_format = image_format;
+  entry.width_scaled = width_scaled;
+  entry.height_scaled = height_scaled;
+  entry.last_acquired = ++ng2_native_resolve_acquire_counter_;
+  REXGPU_INFO("NG2 native resolve: snapshot image {:08X} {}x{} format {}", dest_base,
+              width_scaled, height_scaled, uint32_t(image_format));
+  ng2_native_resolves_.push_back(entry);
+  return &ng2_native_resolves_.back();
+}
+
+void VulkanTextureCache::Ng2InvalidateNativeResolves(uint32_t start, uint32_t length) {
+  for (Ng2NativeResolve& entry : ng2_native_resolves_) {
+    if (entry.valid && start < entry.extent_start + entry.extent_length &&
+        entry.extent_start < start + length) {
+      entry.valid = false;
+    }
+  }
+}
+
+void VulkanTextureCache::Ng2DestroyNativeResolves(bool all) {
+  if (all) {
+    for (Ng2NativeResolve& entry : ng2_native_resolves_) {
+      ng2_native_resolves_destroy_.push_back(
+          {0, entry.image, entry.allocation, entry.storage_view});
+    }
+    ng2_native_resolves_.clear();
+  }
+  uint64_t completed = command_processor_.GetCompletedSubmission();
+  for (size_t i = 0; i < ng2_native_resolves_destroy_.size();) {
+    if (all || ng2_native_resolves_destroy_[i].submission <= completed) {
+      const Ng2NativeResolveDestroy& destroy = ng2_native_resolves_destroy_[i];
+      if (destroy.view != VK_NULL_HANDLE) {
+        const ui::vulkan::VulkanDevice* vulkan_device = command_processor_.GetVulkanDevice();
+        vulkan_device->functions().vkDestroyImageView(vulkan_device->device(), destroy.view,
+                                                      nullptr);
+      }
+      vmaDestroyImage(vma_allocator_, destroy.image, destroy.allocation);
+      ng2_native_resolves_destroy_.erase(ng2_native_resolves_destroy_.begin() + i);
+    } else {
+      ++i;
+    }
+  }
+}
+
+bool VulkanTextureCache::Ng2TryLoadFromNativeResolve(VulkanTexture& texture,
+                                                     VkFormat host_format) {
+  TextureKey key = texture.key();
+  if (key.dimension != xenos::DataDimension::k2DOrStacked || key.GetDepthOrArraySize() != 1 ||
+      key.mip_max_level != 0 || !key.tiled || key.packed_mips) {
+    return false;
+  }
+  uint32_t base = key.base_page << 12;
+  for (Ng2NativeResolve& entry : ng2_native_resolves_) {
+    if (entry.dest_base == base && ng2_native_resolve_misses_logged_ < 100 &&
+        (!entry.valid || entry.format != key.format ||
+         entry.endian != uint32_t(key.endianness) || entry.pitch_div_32 != key.pitch ||
+         entry.host_format != host_format || entry.width < key.GetWidth() ||
+         entry.height < key.GetHeight())) {
+      ++ng2_native_resolve_misses_logged_;
+      REXGPU_INFO(
+          "NG2 native resolve miss {:08X}: valid {} format {}/{} endian {}/{} pitch {}/{} host "
+          "{}/{} size {}x{} / texture {}x{}",
+          base, entry.valid, uint32_t(entry.format), uint32_t(key.format), entry.endian,
+          uint32_t(key.endianness), entry.pitch_div_32, uint32_t(key.pitch),
+          uint32_t(entry.host_format), uint32_t(host_format), entry.width, entry.height,
+          key.GetWidth(), key.GetHeight());
+    }
+    if (!entry.valid || entry.dest_base != base || entry.format != key.format ||
+        entry.endian != uint32_t(key.endianness) || entry.pitch_div_32 != key.pitch ||
+        entry.host_format != host_format || entry.width < key.GetWidth() ||
+        entry.height < key.GetHeight()) {
+      continue;
+    }
+    uint32_t width_scaled = key.GetWidth() * draw_resolution_scale_x();
+    uint32_t height_scaled = key.GetHeight() * draw_resolution_scale_y();
+    if (width_scaled > entry.width_scaled || height_scaled > entry.height_scaled) {
+      continue;
+    }
+    // Snapshot: transfer write (or an earlier read) -> transfer read.
+    if (entry.layout != VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL) {
+      command_processor_.PushImageMemoryBarrier(
+          entry.image, ui::vulkan::util::InitializeSubresourceRange(),
+          entry.write_stage, VK_PIPELINE_STAGE_TRANSFER_BIT, entry.write_access,
+          VK_ACCESS_TRANSFER_READ_BIT, entry.layout, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+      entry.layout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    }
+    texture.MarkAsUsed();
+    VulkanTexture::Usage old_usage = texture.SetUsage(VulkanTexture::Usage::kTransferDestination);
+    if (old_usage != VulkanTexture::Usage::kTransferDestination) {
+      VkPipelineStageFlags src_stage, dst_stage;
+      VkAccessFlags src_access, dst_access;
+      VkImageLayout old_layout, new_layout;
+      GetTextureUsageMasks(old_usage, src_stage, src_access, old_layout);
+      GetTextureUsageMasks(VulkanTexture::Usage::kTransferDestination, dst_stage, dst_access,
+                           new_layout);
+      command_processor_.PushImageMemoryBarrier(
+          texture.image(), ui::vulkan::util::InitializeSubresourceRange(), src_stage, dst_stage,
+          src_access, dst_access, old_layout, new_layout);
+    }
+    command_processor_.SubmitBarriers(true);
+    VkImageCopy region = {};
+    region.srcSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    region.srcSubresource.layerCount = 1;
+    region.dstSubresource = region.srcSubresource;
+    region.extent.width = width_scaled;
+    region.extent.height = height_scaled;
+    region.extent.depth = 1;
+    command_processor_.deferred_command_buffer().CmdVkCopyImage(
+        entry.image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, texture.image(),
+        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, region);
+    if (++ng2_native_resolve_loads_ <= 40 || (ng2_native_resolve_loads_ & 1023) == 1) {
+      REXGPU_INFO("NG2 native resolve: {} texture loads from snapshots (latest {:08X} {}x{})",
+                  ng2_native_resolve_loads_, base, width_scaled, height_scaled);
+    }
+    return true;
+  }
+  return false;
+}
 }  // namespace rex::graphics::vulkan
