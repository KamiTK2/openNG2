diff --git a/include/rex/input/input_filter.h b/include/rex/input/input_filter.h
new file mode 100644
index 0000000..b88380b
--- /dev/null
+++ b/include/rex/input/input_filter.h
@@ -0,0 +1,32 @@
+#pragma once
+// NG2 ADDITION: optional host-side filters on controller state and vibration, so the app
+// can implement deadzones, camera inversion and vibration strength without touching
+// game code.
+
+#include <cstdint>
+#include <functional>
+#include <vector>
+
+#include <rex/input/input.h>
+
+namespace rex::input {
+
+// Called on the merged pad state for a user before it is returned to the game.
+using StateFilter = std::function<void(uint32_t user_index, X_INPUT_STATE* state)>;
+// Called on a vibration request before it reaches the pads (edit in place).
+using VibrationFilter = std::function<void(uint32_t user_index, X_INPUT_VIBRATION* vibration)>;
+
+void SetStateFilter(StateFilter filter);
+void SetVibrationFilter(VibrationFilter filter);
+
+// NG2 ADDITION: the connected physical controllers as SDL sees them (Xbox, PlayStation 4/5,
+// Switch and others), without keyboard / mouse emulation and not blanked while the window is
+// unfocused. For app-side menus and prompt-device detection; empty with the xinput backend.
+enum class PadFamily : uint8_t { kXbox, kPlayStation, kPlayStation5, kNintendo, kOther };
+struct PhysicalPad {
+  X_INPUT_GAMEPAD gamepad;
+  PadFamily family;
+};
+std::vector<PhysicalPad> ReadPhysicalPads();
+
+}  // namespace rex::input
