diff --git a/src/graphics/ng2_cpu_prof.h b/src/graphics/ng2_cpu_prof.h
new file mode 100644
index 0000000..9291093
--- /dev/null
+++ b/src/graphics/ng2_cpu_prof.h
@@ -0,0 +1,94 @@
+// NG2 DIAG: CPU time of the GPU command processor thread, split by phase (cvar diag_cpu_prof).
+// Uses rdtsc; ticks are converted to ms with a steady_clock calibration at each report.
+// Nested scopes (e.g. EndSubmission inside a draw) are excluded from the enclosing phase.
+#pragma once
+
+#include <cstdint>
+#include <intrin.h>
+
+namespace rex::graphics::ng2prof {
+
+enum Phase : uint32_t {
+  kDrawSetup,          // shader analysis, BeginSubmission
+  kDrawPrimitives,     // PrimitiveProcessor::Process (index conversion / guest DMA)
+  kDrawRtCache,        // RenderTargetCache::Update
+  kDrawPipeline,       // shader translation lookup + ConfigurePipeline
+  kDrawTextures,       // TextureCache::RequestTextures
+  kDrawFixedFunc,      // pipeline bind, viewport / scissor / fixed-function state
+  kDrawSysConsts,      // UpdateSystemConstantValues
+  kDrawBindings,       // UpdateBindings (constant buffers, descriptors, root params)
+  kDrawVertexBuffers,  // vertex buffer + memexport residency (shared memory requests)
+  kDrawSubmit,         // topology, index buffer, barriers, draw recording
+  kDrawOther,          // early returns / tail
+  kCopy,               // IssueCopy (resolves)
+  kSwap,               // IssueSwap (presenter hand-over)
+  kEndSubmission,      // EndSubmission minus the deferred list replay
+  kExecute,            // DeferredCommandList::Execute + ExecuteCommandLists
+  kIbCheck,            // NG2 DIAG indirect buffer well-formedness pre-walk
+  kPm4Type0,           // type-0 packets (register writes)
+  kPm4Type3,           // type-3 packets other than draws / copies / swaps (constants, events...)
+  kFenceWait,          // CPU waiting for the GPU (submission fence)
+  kWaitRegMem,         // PM4 WAIT_REG_MEM sleeps (waiting for the guest)
+  kIdle,               // ring empty (waiting for the guest)
+  kCount
+};
+
+inline const char* PhaseName(uint32_t p) {
+  static const char* const names[kCount] = {
+      "draw.setup", "draw.primitives", "draw.rt_cache", "draw.pipeline", "draw.textures",
+      "draw.fixed_func", "draw.sys_consts", "draw.bindings", "draw.vertex_buffers",
+      "draw.submit", "draw.other", "copy", "swap", "end_submission", "execute",
+      "ib_check", "pm4_type0", "pm4_type3",
+      "fence_wait", "wait_reg_mem", "idle"};
+  return p < kCount ? names[p] : "?";
+}
+
+struct State {
+  bool enabled = false;
+  uint64_t acc[kCount] = {};
+  uint64_t nested = 0;  // ticks already attributed by scopes (excluded from enclosing ones)
+  uint64_t draws = 0, copies = 0;
+  uint32_t frame_draws = 0;  // NG2 ADDITION: draws since the last swap, always counted
+};
+extern State g;
+
+inline uint64_t Now() { return __rdtsc(); }
+
+struct Scope {
+  Phase phase;
+  uint64_t start, nested_start;
+  explicit Scope(Phase p) : phase(p), start(g.enabled ? Now() : 0), nested_start(g.nested) {}
+  ~Scope() {
+    if (!start) return;
+    const uint64_t dur = Now() - start;
+    const uint64_t inner = g.nested - nested_start;
+    const uint64_t self = dur > inner ? dur - inner : 0;
+    g.acc[phase] += self;
+    g.nested += self;
+  }
+};
+
+// Sequential phases of one draw: Mark(p) charges the time since the previous mark to p.
+struct DrawTimer {
+  uint64_t last, nested_last;
+  DrawTimer() : last(g.enabled ? Now() : 0), nested_last(g.nested) {
+    ++g.frame_draws;
+    if (last) ++g.draws;
+  }
+  void Mark(Phase p) {
+    if (!last) return;
+    const uint64_t n = Now();
+    const uint64_t inner = g.nested - nested_last;
+    const uint64_t self = (n - last) > inner ? (n - last) - inner : 0;
+    g.acc[p] += self;
+    g.nested += self;
+    last = n;
+    nested_last = g.nested;
+  }
+  ~DrawTimer() { Mark(kDrawOther); }
+};
+
+// Called once per guest swap: refreshes `enabled` from the cvar and logs every N frames.
+void OnSwap();
+
+}  // namespace rex::graphics::ng2prof
