# Deny by default: only the allow-listed files below are tracked. This keeps game data,
# game-derived code (recompiled C++, built exes), dumps, logs and third-party tools out.
/*
!/.gitignore
!/README.md
!/CLAUDE.md
!/LICENSE
!/Setup.bat
!/setup.ps1

!/patches/
!/notes/
/notes/*
!/notes/findings.md
!/notes/roadmap.md

!/tools/
/tools/*
!/tools/*.py
!/tools/*.ps1
!/tools/ghidra-scripts/

!/project/
/project/*
!/project/ng2/
/project/ng2/*
!/project/ng2/src/
!/project/ng2/config/
!/project/ng2/CMakeLists.txt
!/project/ng2/CMakePresets.json
!/project/ng2/ng2.toml
!/project/ng2/ng2_manifest.toml
!/project/ng2/build.cmd
!/project/ng2/run.cmd
# Generated by tools/gen_trace_all.py (diagnostic build only)
/project/ng2/src/ng2_trace_all.cpp
